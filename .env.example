# Hack Club Auth OAuth app (https://auth.hackclub.com -> Developer Apps).
# Copy this file to .env (gitignored, loaded by dotenv-rails in development/test only).
# Redirect URI must match exactly: for local dev, http://localhost:3000/auth/hack_club/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_ISSUER=https://auth.hackclub.com

# Hackatime OAuth app (hackatime.hackclub.com, OAuth apps; scopes: profile and read only).
# Redirect URI must match exactly: for local dev, http://localhost:3000/auth/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Active Record encryption keys (they encrypt the Hackatime tokens). Generate the three values with
# `bin/rails db:encryption:init` and keep them: changing them makes saved tokens unreadable. Required in production.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Production only: comma-separated hostnames Rails will answer to.
APP_HOST=
# Public URL of this app, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Comma-separated Hack Club Auth ids (the OIDC "sub") allowed into /admin. Empty or unset means nobody is an admin.
# Exact, case-sensitive match. In development the Dev login user's id is "dev-user".
ADMIN_HCA_UIDS=

# Production only (set as real environment variables on the platform; see docs/DEPLOY.md for the full list).
# SECRET_KEY_BASE=            # required, generate with `bin/rails secret`
# DATABASE_URL=               # required, postgres://user:password@host:5432/dbname
# CACHE_DATABASE_URL=         # optional, separate database for the Solid Cache table
# TRUSTED_PROXIES=            # optional, comma-separated CIDRs of public-address proxies in front of the app
# RAILS_MASTER_KEY=           # optional, only to read config/credentials.yml.enc
# RAILS_MAX_THREADS=3
# RAILS_LOG_LEVEL=info

# Slack DM notifications (never commit a real token). Bot token with the chat:write scope. Leave unset and
# nothing is sent. Nothing is sent either unless NOTIFICATIONS_ENABLED=true (default off).
# SLACK_BOT_TOKEN=

# Hack Club data-deletion API (docs/PRIVACY_API.md). The defaults are right for production; leave both unset.
# PRIVACY_AUDIENCE=battletown
# PRIVACY_JWKS_URL=https://yeet.hackclub.com/.well-known/jwks.json
