# Hack Club Auth OAuth app (https://auth.hackclub.com -> Developer Apps).
# Copy this file to .env (gitignored, loaded by dotenv-rails in development/test only).
# Redirect URI must match exactly: for local dev, http://localhost:3000/auth/hack_club/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_ISSUER=https://auth.hackclub.com
# Where the checkout address step links to for adding or editing the addresses saved in Hack Club Auth (default: $HCA_ISSUER/portal/address)
# HCA_ADDRESS_PORTAL_URL=

# Hackatime OAuth app (hackatime.hackclub.com, OAuth apps; scopes: profile and read only).
# Redirect URI must match exactly: for local dev, http://localhost:3000/auth/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
# Launch-day escape hatch. Hackatime is a required step of sign-up by default. If Hackatime or its OAuth app breaks, set
# HACKATIME_REQUIRED=0 (or false) and restart: the step then recommends Connect and offers "Skip for now", and the app keeps
# asking people to connect later. Read once at boot (config/application.rb). Leave unset normally.
# HACKATIME_REQUIRED=1
# Where Hackatime time comes from: production defaults to http (live Hackatime, via the hackatime:sync job); development and
# test default to null (no Hackatime calls). Set HOURS_SOURCE=null to switch live hours off, http to try them locally.
# HOURS_SOURCE=

# Active Record encryption keys (they encrypt the Hackatime tokens and shipping addresses). Generate the three values with
# `bin/rails db:encryption:init` and keep them: changing them makes saved tokens unreadable. Required in production.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Production only: comma-separated hostnames Rails will answer to.
APP_HOST=
# Public URL of this app, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Comma-separated Hack Club Auth ids (the OIDC "sub") allowed into /admin. Empty or unset means nobody is an admin.
# Exact, case-sensitive match. In development the Dev login user's id is "dev-user".
ADMIN_HCA_UIDS=

# Production only (set as real environment variables on the platform; see projects/battletown/runbooks/deploy.md for the full list).
# SECRET_KEY_BASE=            # required, generate with `bin/rails secret`
# DATABASE_URL=               # required, postgres://user:password@host:5432/dbname
# CACHE_DATABASE_URL=         # optional, separate database for the Solid Cache table
# TRUSTED_PROXIES=            # optional, comma-separated CIDRs of public-address proxies in front of the app
# RAILS_MASTER_KEY=           # optional, only to read config/credentials.yml.enc
# RAILS_MAX_THREADS=3
# RAILS_LOG_LEVEL=info

# Slack DM notifications and Slack names/pictures on profiles (never commit a real token). One bot token with the chat:write
# and users:read scopes (see config/slack/manifest.yml). Leave unset and nothing is sent and no Slack profile is fetched (players
# keep the generated avatar). DMs are also off unless NOTIFICATIONS_ENABLED=true (default off); the profile fetch only needs the token.
# SLACK_BOT_TOKEN=

# Hack Club data-deletion API (projects/battletown/specs/privacy-api.md). The defaults are right for production; leave both unset.
# PRIVACY_AUDIENCE=battletown
# PRIVACY_JWKS_URL=https://yeet.hackclub.com/.well-known/jwks.json

# First-party analytics (config/analytics.yml; projects/battletown/plans/analytics.md). Nothing is ever deleted on a schedule.
# Staff (ADMIN_HCA_UIDS) and simulated players are never measured; list testers and friends here (comma-separated Hack Club Auth ids,
# empty by default), then run `bin/rails analytics:refresh_exclusions`.
# ANALYTICS_EXCLUDE_HCA_UIDS=
# Kill switch without a deploy: turn the Flipper flag `analytics_paused` ON at /admin/flipper (stops within 30 seconds). This is the boot-time
# version, for when the database cannot be reached to flip it.
# ANALYTICS_DISABLED=true
