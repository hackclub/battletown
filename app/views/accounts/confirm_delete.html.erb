<% content_for :title, "Delete my account" %>
<section class="container account">
  <h1>Delete my account</h1>
  <div class="card account__danger">
    <p>This permanently deletes your Battletown account, your onboarding answers and everything else we stored about you. It cannot be undone. Your Hack Club account is not affected, and you can sign up again later as a new member.</p>
    <p>Want a copy first? <%= link_to "Download my data", account_export_path, data: { turbo: false } %>.</p>
    <%= form_with url: account_path, method: :delete do |f| %>
      <div class="account__field">
        <%= f.label :confirmation do %>To confirm, type <span class="account__phrase"><%= AccountSettings.delete_phrase %></span> in capital letters<% end %>
        <%= f.text_field :confirmation, autocomplete: "off", autocapitalize: "off", spellcheck: false, required: true, aria_describedby: "delete-hint" %>
        <p id="delete-hint">Nothing is deleted until you press the button.</p>
      </div>
      <div class="account__actions">
        <%= f.button "Permanently delete my account", class: "btn btn--danger" %>
        <%= link_to "Cancel", account_path, class: "btn btn--ghost" %>
      </div>
    <% end %>
  </div>
</section>
