<%# The invite confirmation. Names the inviter's display name (and only that) because the person chose to open the link. -%>
<% content_for :title, "Join a crew" %>
<% percent = team_bonus_percent_text %>
<div class="container team stack stack--lg">
  <header class="page-header">
    <p class="eyebrow">Crew invite</p>
    <h1>Join <%= crew_member_name(@inviter) %>'s crew?</h1>
    <p class="lead">A crew is a few friends who code on the same days. When you and a crewmate both code on a day, your hours that day earn a <%= percent %>% coin bonus when a ship is approved.</p>
  </header>

  <section class="card stack" aria-labelledby="share-title">
    <h2 id="share-title" class="card__title">What the crew can see</h2>
    <ul class="list">
      <li><span>Everyone in the crew sees your <strong>display name</strong>, the same name shown on your Battletown dashboard. Nothing else: no hours, coins, Slack id or email.</span></li>
      <li>You see the display names of the others the same way.</li>
      <li>You can leave at any time. Coins you already earned stay yours. After you leave there is a <%= Teams::Config.current.leave_cooldown_seconds / 3600 %> hour wait before joining another crew.</li>
    </ul>
    <p class="muted small">This crew has <%= @member_count %> of <%= Teams::Config.current.max_size %> people.</p>

    <% if @error %>
      <p class="alert alert--danger" role="alert"><%= @error %></p>
    <% end %>

    <% if @current_crew %>
      <p class="alert alert--warning">You are already in a crew. Leave it first (on <%= link_to "your crew page", team_path %>) if you want to join this one.</p>
    <% elsif @cooldown %>
      <p class="alert alert--warning">You left a crew recently. You can join another one from <%= crew_time(@cooldown.ends_at) %>.</p>
    <% elsif @member_count >= Teams::Config.current.max_size %>
      <p class="alert alert--warning">This crew is full.</p>
    <% else %>
      <div class="cluster">
        <%= button_to "Join this crew", team_join_path(params[:token]), method: :post, class: "btn btn--primary btn--lg", form: { data: { turbo: false } } %>
        <%= link_to "No thanks", dashboard_path, class: "btn btn--ghost" %>
      </div>
    <% end %>
  </section>
</div>
