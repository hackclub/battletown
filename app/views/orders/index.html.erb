<% content_for :title, "Your orders" %>
<section class="container shop stack">
  <header class="page-header">
    <p class="eyebrow">Battletown shop</p>
    <h1>Your orders</h1>
    <p class="lead shop-lead">You have <strong><%= coins_text(@total) %></strong>.</p>
    <p><%= link_to "Back to the shop", shop_path, class: "btn btn--ghost" %></p>
  </header>

  <% if @orders.empty? %>
    <div class="empty">
      <%= image_tag "design/map-tree.svg", alt: "", class: "empty__art", width: 73, height: 119 %>
      <h2 class="empty__title">No orders yet</h2>
      <p class="empty__text">When you get something from the shop, it shows up here.</p>
      <div class="empty__actions"><%= link_to "Browse the shop", shop_path, class: "btn btn--primary" %></div>
    </div>
  <% else %>
    <ul class="shop-orders" role="list">
      <% @orders.each do |order| %>
        <li class="card shop-order" id="order-<%= order.id %>">
          <span class="shop-order__art" aria-hidden="true"><%= order.emoji %></span>
          <div class="shop-order__body">
            <div class="shop-order__head">
              <h2 class="shop-order__name"><%= link_to order.display_name, order_path(order), "aria-label": "#{order.display_name}: see this order" %></h2>
              <span class="badge shop-status <%= order_status_class(order) %> <%= order_status_badge(order) %>"><%= order_status_text(order) %></span>
            </div>
            <p class="shop-order__meta">
              <%= price_text(order.coins) %> &middot; ordered <%= order_date(order.created_at) %>
              <% if order.shipped? && order.shipped_at %>&middot; shipped <%= order_date(order.shipped_at) %><% end %>
              <% if order.fulfilled? %>&middot; fulfilled <%= order_date(order.fulfilled_at) %><% end %>
              <% if order.cancelled? %>&middot; cancelled <%= order_date(order.cancelled_at) %><%= " (coins refunded)" if order.coins.positive? %><% end %>
              <% if order.refunded? %>&middot; refunded <%= order_date(order.refunded_at) %><%= " (coins refunded)" if order.coins.positive? %><% end %>
            </p>
            <% if order.buyer_status == "requested" %>
              <p class="shop-note"><%= order.address ? "The team will post it to the address you chose." : "The team will message you on Slack to arrange delivery." %></p>
            <% end %>
            <div class="shop-order__actions">
              <%= link_to "See order", order_path(order), class: "btn btn--sm", "aria-label": "See order: #{order.display_name}" %>
              <% if order.requested? && !order.signup_sticker? %>
                <%= button_to "Cancel order", cancel_order_path(order), method: :patch, class: "btn btn--sm",
                              "aria-label": "Cancel order: #{order.display_name}",
                              form: { data: { turbo_confirm: "Cancel this order? Your #{coins_text(order.coins)} come back." } } %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
