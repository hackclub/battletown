<% content_for :title, "#{@page.title} · Docs" %>
<% content_for :head do %>
  <meta name="description" content="<%= @page.lead %>">
<% end %>
<% previous_page = docs_previous(@page) %>
<% next_page = docs_next(@page) %>
<div class="container docs-layout" data-controller="docs-nav">
  <nav class="docs__toc" aria-label="Docs">
    <details class="docs__toc-box" open data-docs-nav-target="details">
      <summary class="docs__toc-title">Docs</summary>
      <ul class="docs__pages">
        <% DocsHelper::PAGES.each do |page| %>
          <% current = page == @page %>
          <li>
            <%= link_to page.title, docs_page_path(page), class: "docs__page-link", "aria-current": ("page" if current) %>
            <% if current %>
              <ul class="docs__sections" aria-label="On this page">
                <% page.sections.each do |id, title, children| %>
                  <li>
                    <a data-docs-nav-target="link" href="#<%= id %>"><%= title %></a>
                    <% if children.any? %>
                      <ul>
                        <% children.each do |child_id, child_title| %>
                          <li><a data-docs-nav-target="link" href="#<%= child_id %>"><%= child_title %></a></li>
                        <% end %>
                      </ul>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  </nav>

  <article class="panel panel--white docs">
    <header class="page-header">
      <p class="eyebrow">Docs</p>
      <h1><%= @page.title %></h1>
      <p class="lead"><%= @page.lead %></p>
    </header>

    <div class="prose">
      <%= render "pages/docs/#{@page.slug}" %>
    </div>

    <nav class="docs__pager" aria-label="Previous and next page">
      <% if previous_page %>
        <%= link_to docs_page_path(previous_page), class: "docs__pager-link docs__pager-link--previous", rel: "prev" do %>
          <span class="docs__pager-label"><span aria-hidden="true">&larr;</span> Previous</span>
          <span class="docs__pager-title"><%= previous_page.title %></span>
        <% end %>
      <% else %>
        <span></span>
      <% end %>
      <% if next_page %>
        <%= link_to docs_page_path(next_page), class: "docs__pager-link docs__pager-link--next", rel: "next" do %>
          <span class="docs__pager-label">Next <span aria-hidden="true">&rarr;</span></span>
          <span class="docs__pager-title"><%= next_page.title %></span>
        <% end %>
      <% end %>
    </nav>
  </article>
</div>
