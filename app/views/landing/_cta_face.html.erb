<%# locals: (label:) -%>
<%# The pink face of the call to action: label plus arrow. Used inside a button or a link with class "cta". -%>
<span class="cta__face">
  <span class="cta__label"><%= label %></span>
  <svg class="cta__arrow" viewBox="0 0 41.778 42" aria-hidden="true" focusable="false"><path d="M4 21H37.778M20.778 38L37.778 21L20.778 4" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</span>
