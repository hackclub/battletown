<%# locals: (variant: nil) -%>
<%# Signed-in users who haven't finished onboarding continue it; everyone else signs up through Hack Club Auth.
    (The development-only Dev login lives in the header nav, once.) variant "bare" is the pink face without the cream
    wrapper, for the blue map band (Figma 138:177). Turbo is off for the sign-up form: the OmniAuth redirect goes
    cross-origin, which fetch-based submits can't follow. -%>
<% css = variant == "bare" ? "cta cta--bare" : "cta" %>
<% if signed_in? %>
  <%= link_to onboarding_path, class: css do %><%= render "landing/cta_face", label: "Continue setup" %><% end %>
<% else %>
  <%= button_to "/auth/hack_club", method: :post, class: css, form: { data: { turbo: false } } do %><%= render "landing/cta_face", label: join_cta_label %><% end %>
<% end %>
