<% content_for :head do %>
  <meta name="description" content="Battletown is a Hack Club You Ship We Ship program. Build projects, take down a weekly boss with the community and earn prizes.">
<% end %>

<div class="landing">
  <%# Hero (Figma 136:75 / 134:1151). The stage is a 1440x1024 composition that scales with the viewport on wide
      screens and restacks on narrow ones; the swoosh image is the pink-edged top of the cream panel below. -%>
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero__stage">
      <%= image_tag "landing/hero-art.webp",
            alt: "Painted scene of a colourful town. A large armoured warrior in a cat-ear helmet holds a scythe, and a small caped fighter in front of them holds a sword.",
            class: "landing-hero__art", width: 1024, height: 659, fetchpriority: "high", decoding: "async" %>
      <%= image_tag "landing/hero-wash.svg", alt: "", class: "landing-hero__wash", width: 1440, height: 1024 %>

      <% if @referral %>
        <p class="landing-referral" role="status">Welcome from <%= @referral.name %>! Join the fight.</p>
      <% end %>

      <div class="landing-hero__content">
        <h1 id="landing-title" class="landing-hero__logo">
          <%= image_tag "landing/logo.svg", alt: "Battletown", width: 579, height: 329 %>
        </h1>
        <p class="landing-hero__tagline">Build projects, <span class="landing-hero__tagline-accent">get gear</span></p>
        <div class="landing-hero__cta">
          <%= render "landing/cta" %>
        </div>
      </div>
    </div>
    <%= image_tag "landing/hero-swoosh.svg", alt: "", class: "landing-hero__swoosh", width: 1440, height: 350 %>
  </section>

  <div class="landing-panel">
    <section class="container landing-intro" aria-label="About Battletown">
      <p class="landing-eyebrow">A Hack Club You Ship We Ship program</p>
      <p class="landing-intro__lead">Code with the community, take down a weekly boss, and earn prizes for the time you put in.</p>
      <p class="landing-intro__sticker"><span aria-hidden="true">🎁</span> Free sticker when you sign up</p>
    </section>

    <section class="container landing-section" aria-labelledby="how-title">
      <h2 id="how-title">How it works</h2>
      <ol class="landing-steps">
        <li class="landing-step">
          <h3>Pick your prize</h3>
          <p>Choose something to work toward. You can see it the whole way through.</p>
        </li>
        <li class="landing-step">
          <h3>Code with Hackatime</h3>
          <p>Build the project you want to make. Your coding time is tracked automatically.</p>
        </li>
        <li class="landing-step">
          <h3>Take down the boss</h3>
          <p>Every hour you code chips away at the weekly boss alongside everyone else. Keep a daily streak for bonuses.</p>
        </li>
        <li class="landing-step">
          <h3>Ship it</h3>
          <p>Submit your project and claim your prize.</p>
        </li>
      </ol>
    </section>

    <section class="container" aria-labelledby="boss-title">
      <div class="landing-boss">
        <%= image_tag "landing/hero-art.webp", alt: "", class: "landing-boss__art", width: 1024, height: 659, loading: "lazy", decoding: "async" %>
        <div class="landing-boss__inner">
          <h2 id="boss-title">Fight together</h2>
          <p>Each boss has a health bar measured in hours of real coding. Everyone who is locked in chips away at it, and every hour you put in counts toward your own prize too.</p>
        </div>
      </div>
    </section>

    <section id="prizes" class="container landing-section" aria-labelledby="prizes-title">
      <h2 id="prizes-title">Pick a prize to work toward</h2>
      <p class="landing-note">The prize lineup is still being finalised. Prices are in hours of coding.</p>
      <ul class="landing-prizes">
        <% @prizes.each do |prize| %>
          <li class="landing-prize">
            <span class="landing-prize__emoji" aria-hidden="true"><%= prize.emoji %></span>
            <h3 class="landing-prize__name"><%= prize.name %></h3>
            <p class="landing-prize__description"><%= prize.description %></p>
            <p class="landing-prize__price"><%= prize.hours_text %></p>
          </li>
        <% end %>
      </ul>
    </section>

    <%# TODO: replace with real social proof (who's locked in, shout-outs) once the program has launched. No made-up numbers. %>
    <section class="container landing-section" aria-labelledby="proof-title">
      <h2 id="proof-title">Who's locked in</h2>
      <div class="landing-proof">
        <p>Teens from across Hack Club will show up here once Battletown launches.</p>
      </div>
    </section>

    <section class="container landing-section" aria-labelledby="faq-title">
      <h2 id="faq-title">FAQ</h2>
      <div class="landing-faq">
        <details>
          <summary>Who can join?</summary>
          <p>Any teen. You sign in with your Hack Club account, and you'll need to verify your identity before you ship a project.</p>
        </details>
        <details>
          <summary>What counts as coding time?</summary>
          <p>Time tracked with Hackatime while you build your project. Please don't inflate your hours. Reading docs or watching videos doesn't count until you build something with what you learned, and art is usually capped at about a third of your project time. Time can't be counted in more than one You Ship We Ship program, and time logged before the program started doesn't count.</p>
        </details>
        <details>
          <summary>How do I earn prizes?</summary>
          <p>Your hours go toward the prize you picked and toward the weekly boss. Keeping a daily streak earns you bonuses.</p>
        </details>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. Battletown is free for teens, run by Hack Club.</p>
        </details>
        <details>
          <summary>How long does it run?</summary>
          <p>It launches this week and runs for at least a month, with the option to extend it if it goes well.</p>
        </details>
      </div>
    </section>

    <section class="container landing-final" aria-labelledby="final-title">
      <h2 id="final-title">Ready to lock in?</h2>
      <%= render "landing/cta" %>
    </section>
  </div>
</div>
