<%# Final band (owner: final agent): the sand's own tilted edge sits over painted sky, like a dune crest. The sky and clouds are the sky band's own files; the edge is a CSS clip. See landing_world_final.css, which also documents the empty slot for a future painting. -%>
<% sky_sizes = "(min-width: 37rem) 1576px, calc((100vw - 1rem) * 1576 / 576)" %>
<div class="world__shore shore--sand"></div>
<div class="world__shore shore--air">
  <div class="island__skybox">
    <%= image_tag "landing/world/sky/sky@c.webp", alt: "", class: "island__sky", width: 3152, height: 1202, loading: "lazy", decoding: "async",
          srcset: { "landing/world/sky/sky@a.webp" => "1576w", "landing/world/sky/sky@b.webp" => "2049w", "landing/world/sky/sky@c.webp" => "3152w" }, sizes: sky_sizes %>
    <div class="island__haze"></div>
  </div>
  <% cloud_srcset = { "landing/world/sky/cloud@a.webp" => "374w", "landing/world/sky/cloud@b.webp" => "486w", "landing/world/sky/cloud@c.webp" => "748w" } %>
  <% %w[a b c].each do |id| %>
    <%= image_tag "landing/world/sky/cloud@c.webp", alt: "", class: "island__cloud island__cloud--#{id}", width: 748, height: 194, loading: "lazy", decoding: "async", srcset: cloud_srcset, sizes: "(min-width: 48rem) 300px, 130px" %>
  <% end %>
</div>
<%# The sand's wall ending: one run of his real plateau wall, recolored into the sand family. Not clipped, so it covers the sand and sky edge. -%>
<%= image_tag "landing/world/final/sand-wall@c.webp", alt: "", class: "final__wall", width: 3152, height: 360, loading: "lazy", decoding: "async" %>
