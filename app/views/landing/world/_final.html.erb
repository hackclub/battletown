<%# Final band (owner: final agent): the teal ground again under the sand's shore, with the cliff band's painted path (same files, lower stretch only) leading to the call to action. The shore is a CSS clip, see landing_world_final.css, which also documents the empty slot for a future painting. -%>
<% %w[shade ground].each do |layer| %>
  <div class="world__shore shore--<%= layer %>"></div>
<% end %>
<div class="ground__path">
  <%= image_tag "landing/world/cliff/path@c.webp", alt: "", width: 300, height: 880, loading: "lazy", decoding: "async",
        srcset: { "landing/world/cliff/path@a.webp" => "150w", "landing/world/cliff/path@b.webp" => "195w", "landing/world/cliff/path@c.webp" => "300w" }, sizes: "(min-width: 48rem) 240px, 104px" %>
</div>
