<%# Final band (owner: final agent): night ground. The sand edge is a CSS clip over the site's ink blue, with a thin darker-sand shade under the lip. The only decoration is the logo's four-point sparkle, one inline symbol reused, so no image bytes load. Each star's place is a class in landing_world_final.css (the CSP forbids style attributes). See that file, which also documents the empty slot for a future painting. -%>
<% %w[shade ground].each do |layer| %>
  <div class="world__shore shore--<%= layer %>"></div>
<% end %>
<svg class="night__defs" aria-hidden="true" focusable="false"><symbol id="night-star" viewBox="0 0 100 100"><path d="M50 0C52 31 69 48 100 50C69 52 52 69 50 100C48 69 31 52 0 50C31 48 48 31 50 0Z"/></symbol></svg>
<% (1..9).each do |n| %>
  <svg class="night__star night__star--<%= n %>" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#night-star"/></svg>
<% end %>
