<%# Cliff band (owner: cliff agent): the clifftop with its crack, the cliff face and its shadow (one piece, 1576 wu wide), the path
    (one piece), and the same clifftop and face continued to the window edges (cliff-ext, cliff-fill). All placed from the
    signpost's pole foot, see landing_world_cliff.css. -%>
<%= image_tag "landing/world/cliff/cliff-ext-l@c.webp", alt: "", class: "world__img world__ext world__ext--left", width: 1000, height: 900, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/cliff-ext-l@a.webp" => "500w", "landing/world/cliff/cliff-ext-l@b.webp" => "650w", "landing/world/cliff/cliff-ext-l@c.webp" => "1000w" },
      sizes: "(min-width: 37rem) 500px, calc((100vw - 1rem) * 0.87)" %>
<%= image_tag "landing/world/cliff/cliff-ext-r@c.webp", alt: "", class: "world__img world__ext world__ext--right", width: 1000, height: 900, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/cliff-ext-r@a.webp" => "500w", "landing/world/cliff/cliff-ext-r@b.webp" => "650w", "landing/world/cliff/cliff-ext-r@c.webp" => "1000w" },
      sizes: "(min-width: 37rem) 500px, calc((100vw - 1rem) * 0.87)" %>
<%= image_tag "landing/world/cliff/cliff-fill-l@c.webp", alt: "", class: "world__img world__fill world__fill--left", width: 8, height: 900, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/cliff-fill-l@a.webp" => "4w", "landing/world/cliff/cliff-fill-l@b.webp" => "5w", "landing/world/cliff/cliff-fill-l@c.webp" => "8w" }, sizes: "8px" %>
<%= image_tag "landing/world/cliff/cliff-fill-r@c.webp", alt: "", class: "world__img world__fill world__fill--right", width: 8, height: 900, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/cliff-fill-r@a.webp" => "4w", "landing/world/cliff/cliff-fill-r@b.webp" => "5w", "landing/world/cliff/cliff-fill-r@c.webp" => "8w" }, sizes: "8px" %>
<%= image_tag "landing/world/cliff/cliff@c.webp", alt: "", class: "world__img world__cliff", width: 3152, height: 900, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/cliff@a.webp" => "1576w", "landing/world/cliff/cliff@b.webp" => "2049w", "landing/world/cliff/cliff@c.webp" => "3152w" },
      sizes: "(min-width: 37rem) 1576px, calc((100vw - 1rem) * 2.736)" %>
<%= image_tag "landing/world/cliff/path@c.webp", alt: "", class: "world__img world__path", width: 300, height: 880, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cliff/path@a.webp" => "150w", "landing/world/cliff/path@b.webp" => "195w", "landing/world/cliff/path@c.webp" => "300w" },
      sizes: "(min-width: 37rem) 150px, calc((100vw - 1rem) * 0.26)" %>
