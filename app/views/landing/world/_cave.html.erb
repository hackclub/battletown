<%# Cave band (owner: cave agent): the curved rim, the wall with its pillars and ledge. Canvas y 3080..4750, anchored to the bottom of .fight.
    The piece is transparent above the rim (the cliff band's teal shows through). Outside the painting's width the outer 1100 canvas px of each
    side are drawn again, three times outward, flipped and unflipped in turn (CSS scale -1 1 on the odd copies): the art is continuous at every join,
    so real painting runs out to the window edges (up to 3840 wide). -%>
<% %w[l r].each do |side| %>
  <% srcset = { "landing/world/cave/cave-ext-#{side}@a.webp" => "550w", "landing/world/cave/cave-ext-#{side}@b.webp" => "715w", "landing/world/cave/cave-ext-#{side}@c.webp" => "1100w" } %>
  <% (1..3).each do |n| %>
    <%= image_tag "landing/world/cave/cave-ext-#{side}@c.webp", alt: "", class: "world__img world__ext world__ext--#{side}#{n}", width: 1100, height: 1670, loading: "lazy", decoding: "async", srcset: srcset, sizes: "550px" %>
  <% end %>
<% end %>
<%= image_tag "landing/world/cave/cave@c.webp", alt: "", class: "world__img world__cave", width: 3152, height: 1670, loading: "lazy", decoding: "async",
      srcset: { "landing/world/cave/cave@a.webp" => "1576w", "landing/world/cave/cave@b.webp" => "2049w", "landing/world/cave/cave@c.webp" => "3152w" }, sizes: "1576px" %>
