<%# Locals: record, messages (defaults to the project's), title %>
<% messages = local_assigns[:messages] || project_error_messages(record) %>
<% if record.errors.any? %>
  <div class="alert alert--danger projects-errors" role="alert">
    <p class="alert__title"><%= local_assigns[:title] || "Let's fix a couple of things" %></p>
    <ul>
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
