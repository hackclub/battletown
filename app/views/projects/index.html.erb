<% content_for :title, "Projects" %>
<div class="container projects stack stack--lg">
  <header class="page-header projects-header">
    <div class="projects-header__text">
      <h1>Your projects</h1>
      <p class="lead">Keep a few going. One is active at a time, and that's where your coding time counts.</p>
    </div>
    <% if current_user.projects.count < Project::MAX_PER_USER %>
      <%= link_to "Add a project", new_project_path, class: "btn btn--primary btn--lg" %>
    <% else %>
      <p class="alert projects-limit">You've reached <%= Project::MAX_PER_USER %> projects. Delete one to add another.</p>
    <% end %>
  </header>

  <%= render "projects/suggestions", suggestions: @suggestions %>

  <% if @live.empty? && @archived.empty? %>
    <div class="empty projects-empty-card">
      <%= image_tag "design/map-tree.svg", alt: "", class: "empty__art" %>
      <h2 class="empty__title">No projects yet</h2>
      <p class="empty__text">A project is the thing you're building: a game, a site, a bot, anything. Add it here, link the Hackatime project you code it in, and your hours turn into something you can ship for coins.</p>
      <div class="empty__actions">
        <%= link_to "Add a project", new_project_path, class: "btn btn--primary btn--lg" %>
      </div>
    </div>
  <% end %>

  <% if @live.any? %>
    <ul class="project-list">
      <%= render partial: "projects/project", collection: @live, as: :project %>
    </ul>
  <% end %>

  <% if @archived.any? %>
    <section aria-labelledby="archived-heading" class="stack">
      <h2 class="projects-subhead" id="archived-heading">Archived</h2>
      <ul class="project-list project-list--archived">
        <%= render partial: "projects/project", collection: @archived, as: :project %>
      </ul>
    </section>
  <% end %>
</div>
