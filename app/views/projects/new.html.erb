<% content_for :title, "New project" %>
<div class="container projects projects--narrow stack">
  <p class="projects-back"><%= link_to "Back to your projects", projects_path %></p>
  <header class="page-header">
    <p class="eyebrow">New project</p>
    <h1>Add a project</h1>
    <p class="lead">Got something new to build? Add it here. You can keep a few going, with one active at a time.</p>
  </header>
  <div class="card"><%= render "projects/form", project: @project %></div>
</div>
