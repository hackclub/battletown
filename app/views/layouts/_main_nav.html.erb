<%# locals: (label: "Main") -%>
<%# The signed-in header navigation (also previewed on /dev/styleguide): four plain links, no menus. Projects is reached
    from the Profile page and the dashboard; Hackatime and notifications live on the one Settings page. -%>
<nav class="site-header__nav" aria-label="<%= label %>">
  <%= nav_link "Dashboard", dashboard_path %>
  <%# Profile is current on your own page (/profile, or your own /players/<address>), never on someone else's. -%>
  <%= nav_link "Profile", profile_path, section: [ profile_path, (player_path(current_user.public_slug) if current_user&.public_slug.present?) ].compact %>
  <%= nav_link "Armoury", shop_path %>
  <%= nav_link "Settings", settings_path %>
</nav>
