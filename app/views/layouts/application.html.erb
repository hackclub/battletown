<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Battletown">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body <%= tag.attributes(class: content_for(:body_class).presence) %>>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <%# The logo is decorative (alt=""); the link's name is the visually hidden word, so it is announced once. %>
        <%= link_to root_path, class: "site-header__brand" do %>
          <%= image_tag "design/logo.svg", alt: "", class: "site-header__logo", width: 77, height: 44 %><span class="visually-hidden">Battletown</span>
        <% end %>
        <% if signed_in? && current_user.onboarded? %>
          <%= render "layouts/main_nav" %>
        <% end %>
        <div class="site-header__account">
          <% if signed_in? %>
            <%= admin_tool(:div, label: false) { link_to "Admin", admin_root_path, "aria-current": ("page" if request.path.start_with?("/admin")) } %>
            <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn--ghost" %>
          <% else %>
            <%= render "shared/signup_button", label: "Sign in", css: "btn btn--primary btn--sm" %>
            <%= dev_tool(:div, label: false) { button_to "Dev login", dev_login_path, class: "btn btn--ghost", form: { data: { turbo: false } } } %>
          <% end %>
        </div>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash flash--<%= type %>" role="status"><%= message %></div>
    <% end %>

    <main id="main" class="page" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>A Hack Club program</span>
        <nav aria-label="Legal">
          <%= link_to "Privacy", privacy_path %>
          <%= link_to "Terms", terms_path %>
        </nav>
      </div>
    </footer>
  </body>
</html>
