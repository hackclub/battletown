<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Battletown">
    <meta name="theme-color" content="#1472d5">
    <%# Link previews (Slack, Discord, search, social): a page can set content_for :meta_description or :share_title; the
        URL and the 1200x630 image (public/og-image.png) are absolute, built on APP_URL. %>
    <% share_title = content_for(:share_title).presence || page_title %>
    <% share_description = content_for(:meta_description).presence || default_meta_description %>
    <meta name="description" content="<%= share_description %>">
    <meta property="og:site_name" content="Battletown">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= share_title %>">
    <meta property="og:description" content="<%= share_description %>">
    <meta property="og:url" content="<%= public_url(request.path) %>">
    <meta property="og:image" content="<%= public_url("/og-image.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="The Battletown logo in front of a boss in armour and a pink cloak">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= share_title %>">
    <meta name="twitter:description" content="<%= share_description %>">
    <meta name="twitter:image" content="<%= public_url("/og-image.png") %>">
    <link rel="manifest" href="/manifest.json">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/icon-180.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body <%= tag.attributes(class: content_for(:body_class).presence) %>>
    <a class="skip-link" href="#main">Skip to main content</a>

    <%# A page can leave out the header (content_for :hide_site_header) or the footer (:hide_footer): onboarding does, so its
        progress strip is the top of the page. %>
    <% unless content_for?(:hide_site_header) %>
    <header class="site-header">
      <div class="container site-header__inner">
        <%# The logo is decorative (alt=""); the link's name is the visually hidden word, so it is announced once. %>
        <%= link_to root_path, class: "site-header__brand" do %>
          <%= image_tag "design/logo.svg", alt: "", class: "site-header__logo", width: 77, height: 44 %><span class="visually-hidden">Battletown</span>
        <% end %>
        <% if signed_in? && current_user.onboarded? %>
          <%= render "layouts/main_nav" %>
        <% end %>
        <div class="site-header__account">
          <% if signed_in? %>
            <%= admin_tool(:div, label: false) { link_to "Admin", admin_root_path, "aria-current": ("page" if request.path.start_with?("/admin")) } %>
            <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn--ghost" %>
          <% else %>
            <%# A signed-out visitor only needs a Sign in after being sent here by a "sign in to continue" alert, so the
                landing page stays free of one. %>
            <% if flash[:alert].present? %>
              <%= render "shared/signup_button", label: "Sign in", css: "btn btn--primary btn--sm" %>
            <% end %>
            <%= dev_tool(:div, label: false) { button_to "Dev login", dev_login_path, class: "btn btn--ghost", form: { data: { turbo: false } } } %>
          <% end %>
        </div>
      </div>
    </header>
    <% end %>

    <%# Onboarding shows its flash messages inside the step (and focuses them): see onboardings/_frame. %>
    <% unless content_for?(:flash_in_page) %>
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>" role="status"><%= message %></div>
      <% end %>
    <% end %>

    <main id="main" class="page" tabindex="-1">
      <%= yield %>
    </main>

    <% unless content_for?(:hide_footer) %>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>A Hack Club program</span>
        <nav aria-label="Legal">
          <%= legal_link %>
        </nav>
      </div>
    </footer>
    <% end %>
  </body>
</html>
