<% content_for :title, "Ship: #{@ship.project.name}" %>
<div class="container projects projects--narrow stack stack--lg">
  <p class="projects-back"><%= link_to "Back to your ships", ships_path %></p>
  <header class="page-header ship__head ship__head--page">
    <h1><%= @ship.project.name %></h1>
    <%= ship_status_badge(@ship) %>
  </header>

  <% case @ship.status %>
  <% when "submitted" %>
    <p class="alert projects-lead">Waiting for review. A staff member will look at it soon. You can keep coding: time you log from now goes into your next ship.</p>
  <% when "approved" %>
    <section class="card ship-result stack" aria-labelledby="ship-result-heading">
      <h2 id="ship-result-heading" class="card__title">Approved</h2>
      <p class="ship-result__line">
        <%= ship_hours(@ship.approved_seconds) %> approved <span aria-hidden="true">&rarr;</span><span class="visually-hidden">gives</span>
        <%= @breakdown[:base] %> base <%= "coin".pluralize(@breakdown[:base]) %> + <%= @breakdown[:bonus] %> streak bonus <%= "coin".pluralize(@breakdown[:bonus]) %>
        = <strong><%= @breakdown[:total] %> <%= "coin".pluralize(@breakdown[:total]) %></strong>
      </p>
      <% if @ship.approved_seconds < @ship.coded_seconds %>
        <p class="projects-hint muted">You coded <%= ship_hours(@ship.coded_seconds) %>; the reviewer approved <%= ship_hours(@ship.approved_seconds) %>.</p>
      <% end %>
      <%= render "ships/unlock_note" %>
    </section>
  <% when "rejected" %>
    <section class="card ship-result ship-result--rejected stack" aria-labelledby="ship-result-heading">
      <h2 id="ship-result-heading" class="card__title">Needs changes</h2>
      <p class="alert alert--danger">A reviewer said: <%= @ship.rejection_reason %></p>
      <p>Your hours are still yours: fix it and ship the same hours again.</p>
      <div><%= link_to "Fix and ship again", new_project_ship_path(@ship.project, from: @ship.id), class: "btn btn--primary btn--lg" %></div>
    </section>
  <% when "withdrawn" %>
    <p class="alert projects-lead">You withdrew this ship, so its hours are free for your next one.</p>
  <% when "draft" %>
    <p class="alert projects-lead">This is a draft. Nobody has seen it yet.</p>
  <% end %>

  <section class="card ship-facts stack" aria-labelledby="ship-facts-heading">
    <h2 id="ship-facts-heading" class="card__title">What you sent</h2>
    <dl class="ship-dl">
      <dt>Hours coded</dt><dd><%= ship_hours(@ship.coded_seconds) %> (<%= ship_dates_text(@ship.window_start_date, @ship.window_end_date) %>)</dd>
      <% if @ship.submitted_at %><dt>Submitted</dt><dd><%= ship_submitted_on(@ship, year: true) %></dd><% end %>
      <dt>Description</dt><dd class="ship-dl__text"><%= @ship.description.presence || "Not written yet" %></dd>
      <% if @ship.repo_url.present? %><dt>GitHub</dt><dd><%= project_external_link @ship.repo_url.delete_prefix("https://"), @ship.repo_url %></dd><% end %>
      <% if @ship.demo_url.present? %><dt>Demo</dt><dd><%= project_external_link @ship.demo_url.delete_prefix("https://"), @ship.demo_url %></dd><% end %>
    </dl>
  </section>

  <div class="projects-actions">
    <% if @ship.status_draft? %><%= link_to "Continue draft", edit_ship_path(@ship), class: "btn btn--primary" %><% end %>
    <% if @ship.open? %>
      <%= button_to (@ship.status_draft? ? "Discard draft" : "Withdraw ship"), withdraw_ship_path(@ship), method: :patch, class: "btn",
                    form: { data: { turbo_confirm: (@ship.status_submitted? ? "Withdraw this ship? Its hours go back into your next ship." : nil) } } %>
    <% end %>
    <%= link_to "Your projects", projects_path, class: "btn btn--ghost" %>
  </div>
</div>
