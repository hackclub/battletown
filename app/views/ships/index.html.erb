<% content_for :title, "Your ships" %>
<section class="container projects">
  <header class="projects-header">
    <div>
      <h1>Your ships</h1>
      <p class="projects-lead">Ship a project to turn the hours you coded into approved hours and coins.</p>
    </div>
    <%= link_to "Your projects", projects_path, class: "btn btn--primary btn--lg" %>
  </header>

  <% if @ships.empty? %>
    <div class="card projects-empty-card">
      <h2>No ships yet</h2>
      <p>When you've coded a while on a project, press Ship on it from your projects page. It shows how many hours are ready to ship.</p>
      <%= link_to "Go to your projects", projects_path, class: "btn btn--primary" %>
    </div>
  <% else %>
    <% if @ships.any?(&:status_approved?) %>
      <%= render "ships/unlock_note" %>
    <% end %>
    <ul class="project-list">
      <%= render partial: "ships/ship", collection: @ships, as: :ship %>
    </ul>
  <% end %>
</section>
