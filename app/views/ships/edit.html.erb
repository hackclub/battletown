<% content_for :title, "Edit ship: #{@project.name}" %>
<div class="container projects projects--narrow stack stack--lg">
  <p class="projects-back"><%= link_to "Back to your ships", ships_path %></p>
  <header class="page-header">
    <p class="eyebrow">Draft ship</p>
    <h1>Ship <%= @project.name %></h1>
    <p class="lead">This ship is a draft. The hours below are counted again when you submit it.</p>
  </header>
  <%= render "ships/form", ship: @ship, project: @project, readiness: @readiness, window: @window, previous_ship: @previous_ship, min_seconds: @min_seconds %>
  <div><%= button_to "Discard draft", withdraw_ship_path(@ship), method: :patch, class: "btn btn--ghost" %></div>
</div>
