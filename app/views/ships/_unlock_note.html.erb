<%# Shown wherever approved coins are shown to someone who cannot spend yet: the coins are theirs, spending unlocks later. %>
<% state = current_user.spend_state %>
<% if state == :not_eligible || state == :stale %>
  <%# Verified, but the eligibility gate (flag `eligibility_gate`) says not yet. Never says why. %>
  <div class="alert alert--warning ship-note" role="note">
    <p class="alert__title ship-note__title"><%= eligibility_text(state) %></p>
    <p>The coins are saved for you and you keep earning them. Coding and shipping are never blocked.</p>
    <% if state == :stale %>
      <div><%= render "shared/signup_button", label: "Sign in again", css: "btn btn--sm" %></div>
    <% end %>
  </div>
<% elsif state == :unverified %>
  <div class="alert alert--warning ship-note" role="note">
    <p class="alert__title ship-note__title">Your coins unlock when you verify your identity with Hack Club.</p>
    <% if current_user.verification_ineligible? %>
      <p>Your Hack Club account can't be verified for this program right now. Reach out in the Hack Club Slack and we'll help.</p>
    <% elsif current_user.verification_pending? %>
      <p>Your verification is being checked. The coins are saved for you and unlock as soon as it goes through.</p>
    <% else %>
      <p>The coins are saved for you. <%= ship_verify_link %> (opens in a new tab) and you can spend them in the shop.</p>
    <% end %>
  </div>
<% end %>
