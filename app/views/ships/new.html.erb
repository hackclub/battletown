<% content_for :title, "New ship: #{@project.name}" %>
<div class="container projects projects--narrow stack stack--lg">
  <p class="projects-back"><%= link_to "Back to your projects", projects_path %></p>
  <header class="page-header">
    <p class="eyebrow">New ship</p>
    <h1>Ship <%= @project.name %></h1>
    <p class="lead">Shipping turns the time you've coded into approved hours and coins.</p>
  </header>
  <%= render "ships/form", ship: @ship, project: @project, readiness: @readiness, window: @window, previous_ship: @previous_ship, min_seconds: @min_seconds, carry: @carry_ship %>
</div>
