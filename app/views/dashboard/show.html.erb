<%# The signed-in home page, drawn from the whiteboard sketch and nothing else: your prize, the boss's health bar, the boss in
    the middle with the people who coded in the last day around it, the daily goal, the to-do list, one progress bar and the ship button. Every number and sentence comes from Dashboard::Presenter
    (@dashboard). Styles: dashboard.css. -%>
<% content_for :hide_footer, true %>
<div class="dashboard">
  <h1 class="visually-hidden">Dashboard</h1>
  <%= render "dashboard/stage", d: @dashboard %>
</div>
<%# Development only, local database only: the event simulator panel (bottom-left corner). -%>
<%= render "dashboard/simulator" if dev_simulator? %>
