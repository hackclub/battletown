<%# locals: (prize:) -%>
<%# The chosen prize as a chunky blue shop card (Figma 156:665), with the coins toward it on a cream bar. -%>
<% if prize %>
  <section class="card card--chunky dash-panel dash-prize" aria-labelledby="dash-prize-title">
    <h2 id="dash-prize-title" class="card__title dash-panel__title">Your prize</h2>
    <p class="dash-prize__name"><span class="dash-prize__emoji" aria-hidden="true"><%= prize.emoji %></span> <strong><%= prize.name %></strong>, <%= prize.price_text %><% if prize.hours_text %> <span class="dash-muted">(about <%= prize.hours_text %> of approved coding)</span><% end %></p>
    <% unless prize.free %>
      <div class="progress progress--prize dash-meter">
        <div class="progress__head">
          <label for="dash-prize-progress" class="progress__label dash-meter__label">Coins toward <%= prize.name %></label>
        </div>
        <progress id="dash-prize-progress" class="progress__bar dash-meter__bar" max="<%= prize.price_coins %>" value="<%= prize.progress_value %>" aria-describedby="dash-prize-text"><%= prize.progress_text %></progress>
        <p id="dash-prize-text" class="progress__text dash-meter__text"><%= prize.progress_text %></p>
      </div>
    <% end %>
    <p class="dash-prize__note"><%= prize.message %></p>
    <div class="dash-actions">
      <%= link_to "See it in the shop", shop_path, class: "btn" %>
    </div>
  </section>
<% end %>
