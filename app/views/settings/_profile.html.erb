<h2 id="profile-heading">Profile</h2>
<p class="lead">Every player has a profile page. Other players can see your name, projects and boss damage. You choose the name and picture.</p>

<%= form_with url: settings_profile_path, method: :patch, class: "card settings__profile-form stack", data: { turbo: false } do %>
  <% if current_user.errors.any? %>
    <div id="profile-errors" tabindex="-1" data-controller="focus-errors">
      <%= render "projects/errors", record: current_user, title: "Your display name needs a change",
                 messages: current_user.errors.map { |error| "Display name #{error.message}" } %>
    </div>
  <% end %>

  <% name_error = current_user.errors.include?(:profile_name) %>
  <div class="field <%= "field--invalid" if name_error %>">
    <%= label_tag "profile_name", "Display name" %>
    <%= text_field_tag "profile_name", current_user.profile_name, class: "input", maxlength: PublicProfile::NAME_MAX, autocomplete: "off",
                       placeholder: current_user.fallback_name,
                       aria: { describedby: [ ("profile-name-error" if name_error), "profile-name-hint" ].compact.join(" "), invalid: (true if name_error) } %>
    <% if name_error %>
      <p class="field__error" id="profile-name-error"><%= current_user.errors.messages_for(:profile_name).to_sentence %></p>
    <% end %>
    <p class="field__hint" id="profile-name-hint">Other players see this name. Leave it empty and they see <strong><%= current_user.fallback_name %></strong>. Up to <%= PublicProfile::NAME_MAX %> characters: letters, numbers, spaces and . _ - ' only. We never show your real name or email.</p>
  </div>

  <%= render "settings/slack_profile" %>

  <div class="settings__actions">
    <%= submit_tag "Save profile settings", class: "btn btn--primary btn--lg" %>
    <%= link_to "View my profile", profile_path, class: "btn" %>
  </div>
<% end %>
