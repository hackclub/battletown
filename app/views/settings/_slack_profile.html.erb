<%# locals: () -%>
<%# The "Use my Slack name and picture" choice (SlackProfiles::Choice), inside the profile form (_profile.html.erb). It is on until the player
    turns it off and only decides what is shown: the profile page exists either way. The stored Slack name is only echoed back to its owner. -%>
<% slack_profile = SlackProfile.for(current_user) %>
<div class="notification-settings__item">
  <%= hidden_field_tag "use_slack", "0", id: nil %>
  <%= check_box_tag "use_slack", "1", SlackProfiles::Choice.use_slack?(current_user), id: "use_slack", class: "notification-settings__box", aria: { describedby: "use_slack_hint" } %>
  <div class="notification-settings__text">
    <label class="notification-settings__title notification-settings__tap" for="use_slack">Use my Slack name and picture</label>
    <div class="notification-settings__hint" id="use_slack_hint">
      <p>On: other players see your Slack picture, and your Slack name if you have not set a display name above. Off: they see a coloured circle with your initial and a made-up name.</p>
      <p>We keep a small copy of the picture and refresh it once a day. Turn this off and the copy is deleted.<% if slack_profile&.display_name.present? %> Your Slack name right now: <strong><%= slack_profile.display_name %></strong>.<% end %></p>
    </div>
  </div>
</div>
