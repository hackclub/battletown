<% content_for :title, "Confirm hours adjustment" %>
<% adjustment = @adjustment %>
<div class="container container--wide">
  <%= admin_tool(:div, class: "admin-dashboard admin-page") do %>
    <p class="admin-back"><%= link_to "Back to #{admin_person_name(@user.display_name, @user.id)}", admin_user_path(@user) %></p>
    <header class="page-header">
      <h1>Confirm the hours change</h1>
      <p class="admin-dashboard__note">Nothing has been changed yet. Check the numbers and your reason, then confirm.</p>
    </header>

    <% if adjustment.settled_day? %>
      <div class="alert alert--warning admin-warning" role="note">
        <p class="alert__title admin-warning__title">That day has already settled</p>
        <p>The streak and coins for <%= adjustment.local_date.strftime("%-d %b") %> were fixed when it settled and will not change. Boss damage and total hours will.</p>
      </div>
    <% end %>
    <% if adjustment.past_daily_cap? %>
      <div class="alert alert--warning admin-warning" role="note">
        <p class="alert__title admin-warning__title">Past the daily limit</p>
        <p>This puts the day above the usual limit of <%= admin_duration(Hours::Config.current.daily_cap_seconds) %> a day. Staff adjustments may do that, but check it is right.</p>
      </div>
    <% end %>

    <section class="card admin-panel admin-form-card" aria-labelledby="hours-summary">
      <h2 id="hours-summary" class="card__title">Summary</h2>
      <dl class="admin-dl">
        <dt>Person</dt><dd><%= admin_person_name(@user.display_name, @user.id) %></dd>
        <dt>Date</dt><dd><%= adjustment.local_date.strftime("%A %-d %B %Y") %></dd>
        <dt>Change</dt><dd><strong><%= adjustment.add? ? "Add" : "Take off" %> <%= admin_duration(adjustment.seconds.abs) %></strong></dd>
        <dt>That day</dt><dd><%= admin_duration(adjustment.day_before) %> now, <strong><%= admin_duration(adjustment.day_after) %></strong> after</dd>
        <dt>Your reason</dt><dd class="admin-text"><%= adjustment.reason %></dd>
      </dl>
      <%= form_with url: admin_user_hours_adjustment_path(@user), method: :post, class: "admin-form stack" do |form| %>
        <%= hidden_field_tag :confirmed, "1", id: nil %>
        <%= render "admin/shared/adjustment_hidden", adjustment: adjustment, fields: %w[token direction date minutes reason] %>
        <div class="admin-actions">
          <%= form.submit "Confirm and apply", class: "btn btn--primary" %>
          <%= link_to "Start again", new_admin_user_hours_adjustment_path(@user), class: "btn" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
