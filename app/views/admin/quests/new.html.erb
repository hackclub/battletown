<% content_for :title, "New quest" %>
<div class="container container--wide">
  <%= admin_tool(:div, class: "admin-dashboard admin-page") do %>
    <p class="admin-back"><%= link_to "Back to the weekly quests", admin_quests_path %></p>
    <header class="page-header">
      <h1>Set a quest</h1>
      <p class="admin-dashboard__note">Pick the boss week, one goal from the menu and the reward. The quest is checked automatically; nobody reviews it by hand.</p>
    </header>
    <% weeks = Quest.open_weeks.to_a %>
    <% if weeks.empty? %>
      <p class="alert">Every upcoming boss week already has a quest (or there is no boss yet: add one under Weekly bosses).</p>
    <% else %>
      <%= render "form", quest: @quest, url: admin_quests_path, method: :post, weeks: weeks %>
    <% end %>
  <% end %>
</div>
