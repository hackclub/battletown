<% content_for :title, "New boss" %>
<div class="container container--wide">
  <%= admin_tool(:div, class: "admin-dashboard admin-page") do %>
    <p class="admin-back"><%= link_to "Back to the weekly bosses", admin_bosses_path %></p>
    <header class="page-header">
      <h1>Add a boss</h1>
      <p class="admin-dashboard__note">Pick the week, a name and how many hours of coding it takes to beat it. A picture is optional: without one the built-in picture is used. The week can't be changed later.</p>
    </header>
    <%= render "form", boss: @boss, url: admin_bosses_path, creating: true, weeks: @weeks, previous: @previous, use_previous: @use_previous %>
  <% end %>
</div>
