<%= table_region(caption) do %>
  <table class="table table--zebra admin-table">
    <caption><%= caption %></caption>
    <thead>
      <tr>
        <th scope="col"><%= heading %></th>
        <th scope="col" class="num admin-table__num">Users</th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <th scope="row"><%= row.label %></th>
          <td class="num admin-table__num"><%= number_with_delimiter(row.count) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
