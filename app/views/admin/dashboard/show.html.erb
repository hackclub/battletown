<% content_for :title, "Admin" %>
<% requested_orders = Order.where(status: "requested").count %>
<div class="container container--wide">
  <%= admin_tool(:div, class: "admin-dashboard admin-page") do %>
    <header class="page-header">
      <h1>Admin dashboard</h1>
      <p class="admin-dashboard__note">Read-only, aggregate counts only. No names, emails or ids are shown here. Signup days are UTC.</p>
    </header>

    <nav aria-label="Admin sections" class="admin-sections">
      <%# Grouped by what staff do: decide things people are waiting on, set up the game, read the numbers, switch features. %>
      <h2 class="admin-sections__title">Waiting for you</h2>
      <ul class="grid admin-links">
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Ship review queue", admin_ships_path %></h3>
          <p class="admin-link__count"><%= admin_badge("#{@pending_ships} waiting", @pending_ships.positive? ? "badge--warning" : "badge--muted") %></p>
          <p class="small">Approve or reject submitted ships.</p>
        </li>
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Shop orders", admin_orders_path %></h3>
          <p class="admin-link__count"><%= admin_badge("#{requested_orders} requested", requested_orders.positive? ? "badge--warning" : "badge--muted") %></p>
          <p class="small">Fulfil or cancel what people ordered.</p>
        </li>
        <% if feature?(:merch_track) %>
          <% requested_merch = MerchClaim.where(status: "requested").count %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "Merch claims", admin_merch_claims_path %></h3>
            <p class="admin-link__count"><%= admin_badge("#{requested_merch} requested", requested_merch.positive? ? "badge--warning" : "badge--muted") %></p>
            <p class="small">Fulfil or cancel weekly reward claims.</p>
          </li>
        <% end %>
      </ul>

      <h2 class="admin-sections__title">People</h2>
      <ul class="grid admin-links">
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Audit trail", admin_audit_path %></h3>
          <p class="small">What staff changed or opened, and when.</p>
        </li>
      </ul>

      <h2 class="admin-sections__title">Set up the game</h2>
      <ul class="grid admin-links">
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Weekly bosses", admin_bosses_path %></h3>
          <p class="small">Names, art and health for each week's boss.</p>
        </li>
        <% if feature?(:quests) %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "Weekly quests", admin_quests_path %></h3>
            <p class="small">The goal and reward for each boss week.</p>
          </li>
        <% end %>
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Feature flags", flipper_ui_path, data: { turbo: false } %></h3>
          <p class="small">Switch new features on or off.</p>
        </li>
      </ul>

      <h2 class="admin-sections__title">Numbers</h2>
      <ul class="grid admin-links">
        <li class="card card--tight admin-link">
          <h3 class="card__title"><%= link_to "Metrics", admin_metrics_path %></h3>
          <p class="small">Daily and weekly actives, funnel, last active day.</p>
        </li>
        <% if feature?(:team) %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "Crews", admin_teams_path %></h3>
            <p class="small">Crew sizes and bonus coins paid.</p>
          </li>
        <% end %>
        <% if feature?(:plinko) %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "Plinko", admin_plinko_path %></h3>
            <p class="small">Balls dropped and players per day and week.</p>
          </li>
        <% end %>
        <% if feature?(:nps) %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "NPS survey", admin_nps_path %></h3>
            <p class="small">Score, trend and staff-only comments.</p>
          </li>
        <% end %>
        <% if feature?(:email) %>
          <li class="card card--tight admin-link">
            <h3 class="card__title"><%= link_to "Email", admin_email_path %></h3>
            <p class="small">Email rows per week, by status.</p>
          </li>
        <% end %>
      </ul>
    </nav>

    <dl class="admin-stat grid">
      <div class="card card--tight admin-stat__item">
        <dt>Total users</dt>
        <dd><%= number_with_delimiter(@stats.total_users) %></dd>
      </div>
      <div class="card card--tight admin-stat__item">
        <dt>Onboarded</dt>
        <dd><%= number_with_delimiter(@stats.onboarded) %></dd>
      </div>
    </dl>

    <div class="admin-grid grid grid--2">
      <%= render "admin/dashboard/table", caption: "Signups per day (last #{AdminStats::SIGNUP_DAYS} days)", heading: "Day (UTC)", rows: @stats.signups_per_day %>
      <%= render "admin/dashboard/table", caption: "Onboarding funnel (reached at least this step)", heading: "Step", rows: @stats.onboarding_funnel %>
      <%= render "admin/dashboard/table", caption: "Verification status", heading: "Status", rows: @stats.verification %>
      <%= render "admin/dashboard/table", caption: "How people heard about us", heading: "Source", rows: @stats.referral_sources %>
      <%= render "admin/dashboard/table", caption: "Prize picks", heading: "Prize", rows: @stats.prizes %>
      <%= render "admin/dashboard/table", caption: "Project kinds", heading: "Kind", rows: @stats.project_kinds %>
    </div>
  <% end %>
</div>
