<% content_for :title, "Admin analytics" %>
<div class="container container--wide">
<%= admin_tool(:div, class: "admin-dashboard admin-page admin-metrics") do %>
  <p class="admin-back"><%= link_to "Back to the admin dashboard", admin_root_path %></p>
  <header class="page-header">
    <h1>Analytics</h1>
    <p class="admin-dashboard__note">
      Read-only, aggregate counts only: no names, emails or ids, and nothing about one person. Staff, simulated players and listed
      testers are left out of every number. A breakdown cell of one to four is shown as "&lt;5". Nothing here is ever deleted on
      a schedule. One report is shown at a time (pick it from the list); each downloads as CSV or JSON; the numbers are cached for five minutes.
    </p>
  </header>

  <div class="admin-metrics__section">
    <nav class="admin-filters" aria-label="Period">
      <% Analytics::Report::RANGES.each do |key| %>
        <%= link_to analytics_range_label(key), admin_analytics_path(range: key, report: @report), class: class_names("btn btn--sm admin-filter", "btn--primary admin-filter--current": @range == key), "aria-current": (@range == key ? "page" : nil) %>
      <% end %>
    </nav>
    <%= button_to "Refresh the numbers", admin_analytics_refresh_path(range: @range, report: @report), method: :post, class: "btn btn--sm" %>
    <nav aria-label="Reports">
      <ul class="admin-filters">
        <% Analytics::Report::KEYS.each do |key| %>
          <li><%= link_to Analytics::Report.label(key), admin_analytics_path(range: @range, report: key), "aria-current": (@report == key ? "page" : nil) %></li>
        <% end %>
      </ul>
    </nav>
  </div>

  <% [ @table ].each do |table| %>
    <section class="admin-metrics__section" aria-labelledby="<%= table.key %>-title" id="<%= table.key %>">
      <h2 id="<%= table.key %>-title"><%= table.title %></h2>
      <p class="admin-metrics__definition"><%= table.description %></p>
      <% if table.note %>
        <p class="alert"><%= table.note %></p>
      <% end %>
      <% if table.rows.empty? %>
        <p class="admin-metrics__definition">Nothing to show yet.</p>
      <% else %>
        <%= table_region(table.title) do %>
          <table class="table table--zebra admin-table admin-metrics__table">
            <caption><%= table.title %></caption>
            <thead>
              <tr>
                <% table.columns.each do |column| %>
                  <th scope="col" class="<%= 'num admin-table__num' if column.numeric? %>"><%= column.label %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% table.rows.each do |row| %>
                <tr>
                  <% table.columns.each_with_index do |column, index| %>
                    <% cell = analytics_cell(column, row[column.key]) %>
                    <% if index.zero? %>
                      <th scope="row"><%= cell %></th>
                    <% else %>
                      <td class="<%= 'num admin-table__num' if column.numeric? %>"><%= cell %></td>
                    <% end %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% end %>
      <p class="small">
        Download <%= table.title.downcase %>:
        <%= link_to "CSV", analytics_download_path(table, @range, :csv) %>,
        <%= link_to "JSON", analytics_download_path(table, @range, :json) %>
      </p>
    </section>
  <% end %>
<% end %>
</div>
