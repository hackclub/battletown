<% content_for :title, "Admin Plinko" %>
<% day_label = ->(date) { tag.time(date.strftime("%a %-d %b"), datetime: date.iso8601) } %>
<div class="container container--wide">
  <%= admin_tool(:div, class: "admin-dashboard admin-page") do %>
    <p class="admin-back"><%= link_to "Back to the admin dashboard", admin_root_path %></p>
    <header class="page-header">
      <h1>Plinko</h1>
      <p class="admin-dashboard__note">
        Read-only, aggregate counts only: no names, nicknames or ids. Plinko never awards coins or prizes, so there is
        nothing to reset or award here. Days are the players' local dates; today is <%= @stats.today.iso8601 %> (UTC)
        and is still filling in. Weeks run Friday to Thursday.
      </p>
    </header>

    <dl class="admin-stat grid">
      <div class="card card--tight admin-stat__item"><dt>Balls dropped, all time</dt><dd><%= number_with_delimiter(@stats.totals.drops) %></dd></div>
      <div class="card card--tight admin-stat__item"><dt>Different players</dt><dd><%= number_with_delimiter(@stats.totals.players) %></dd></div>
      <div class="card card--tight admin-stat__item"><dt>On the leaderboard</dt><dd><%= number_with_delimiter(@stats.totals.on_leaderboard) %></dd></div>
      <div class="card card--tight admin-stat__item"><dt>Points scored, all time</dt><dd><%= number_with_delimiter(@stats.totals.points) %></dd></div>
    </dl>

    <section class="admin-metrics__section" aria-labelledby="plinko-daily">
      <h2 id="plinko-daily">Per day</h2>
      <p class="admin-metrics__definition">Balls dropped and different players per day, last <%= Plinko::AdminStats::DAYS %> days, newest first.</p>
      <%= table_region("Plinko per day") do %>
        <table class="table table--zebra admin-table">
          <caption>Plinko per day (last <%= Plinko::AdminStats::DAYS %> days)</caption>
          <thead>
            <tr>
              <th scope="col">Day</th>
              <th scope="col" class="num admin-table__num">Balls dropped</th>
              <th scope="col" class="num admin-table__num">Players</th>
              <th scope="col" class="num admin-table__num">Points</th>
            </tr>
          </thead>
          <tbody>
            <% @stats.daily.reverse_each do |day| %>
              <tr>
                <th scope="row"><%= day_label.call(day.date) %></th>
                <td class="num admin-table__num"><%= number_with_delimiter(day.drops) %></td>
                <td class="num admin-table__num"><%= number_with_delimiter(day.players) %></td>
                <td class="num admin-table__num"><%= number_with_delimiter(day.points) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <section class="admin-metrics__section" aria-labelledby="plinko-weekly">
      <h2 id="plinko-weekly">Per week</h2>
      <%= table_region("Plinko per week") do %>
        <table class="table table--zebra admin-table">
          <caption>Plinko per week (last <%= Plinko::AdminStats::WEEKS %> weeks)</caption>
          <thead>
            <tr>
              <th scope="col">Week</th>
              <th scope="col" class="num admin-table__num">Balls dropped</th>
              <th scope="col" class="num admin-table__num">Players</th>
              <th scope="col" class="num admin-table__num">Points</th>
            </tr>
          </thead>
          <tbody>
            <% @stats.weekly.reverse_each do |week| %>
              <tr>
                <th scope="row"><%= day_label.call(week.starts_on) %> to <%= day_label.call(week.ends_on) %><%= " (so far)" if week.partial %></th>
                <td class="num admin-table__num"><%= number_with_delimiter(week.drops) %></td>
                <td class="num admin-table__num"><%= number_with_delimiter(week.players) %></td>
                <td class="num admin-table__num"><%= number_with_delimiter(week.points) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>
</div>
