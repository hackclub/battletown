<% content_for :title, "Hackatime" %>
<div class="container hackatime stack stack--lg">
  <header class="page-header">
    <p class="eyebrow">Settings</p>
    <h1>Hackatime</h1>
    <p class="lead">Hackatime tracks the time you spend coding. Connect it and your hours count toward the boss, your streak and your ships without you doing anything.</p>
  </header>

  <section class="card hackatime__card" id="hackatime" aria-labelledby="hackatime-status-heading">
    <div class="hackatime__head">
      <h2 class="card__title" id="hackatime-status-heading">Your connection</h2>
      <% if @connection.nil? %>
        <p class="badge badge--muted hackatime__status hackatime__status--off">Not connected</p>
      <% elsif @connection.needs_reconnect? %>
        <p class="badge badge--warning hackatime__status hackatime__status--warn">Needs reconnecting</p>
      <% else %>
        <p class="badge badge--success hackatime__status hackatime__status--on">Connected</p>
      <% end %>
    </div>

    <% if @connection.nil? %>
      <p>Connecting is optional: you can keep coding and logging time without it. With it, your coding time counts toward the boss automatically.</p>
      <div class="hackatime__actions">
        <%= button_to "Connect Hackatime", "/auth/hackatime", method: :post, class: "btn btn--primary btn--lg", form: { data: { turbo: false } } %>
      </div>
    <% elsif @connection.needs_reconnect? %>
      <p class="alert alert--warning">Hackatime stopped accepting our access, so your time isn't syncing right now. Connect again to pick up where you left off.</p>
      <div class="hackatime__actions">
        <%= button_to "Reconnect Hackatime", "/auth/hackatime", method: :post, class: "btn btn--primary", form: { data: { turbo: false } } %>
        <%= button_to "Disconnect", hackatime_path, method: :delete, class: "btn btn--ghost" %>
      </div>
    <% else %>
      <p class="hackatime__meta">
        <% if @connection.last_synced_at %>
          Last synced <time datetime="<%= @connection.last_synced_at.iso8601 %>"><%= time_ago_in_words(@connection.last_synced_at) %> ago</time>.
        <% else %>
          Not synced yet. Your time shows up after the next sync.
        <% end %>
      </p>
      <div class="hackatime__actions">
        <%= button_to "Disconnect", hackatime_path, method: :delete, class: "btn",
              form: { data: { turbo_confirm: "Disconnect Hackatime? We'll delete the access we saved." } } %>
      </div>
    <% end %>
  </section>

  <section class="card hackatime__card" aria-labelledby="hackatime-share-heading">
    <h2 class="card__title" id="hackatime-share-heading">What gets shared</h2>
    <p class="hackatime__fine">We ask for two read-only permissions on Hackatime (<code>profile</code> and <code>read</code>). That is all we can do.</p>
    <div class="hackatime__share">
      <div>
        <h3>Battletown reads</h3>
        <ul>
          <li>How long you code each day</li>
          <li>The names of your Hackatime projects</li>
          <li>Your Hackatime user id, to know it's you</li>
        </ul>
      </div>
      <div>
        <h3>Battletown never sees</h3>
        <ul>
          <li>Your code or your files</li>
          <li>Your email address</li>
          <li>Anything we can't use to count your time</li>
        </ul>
      </div>
    </div>
    <p class="hackatime__fine">You can disconnect any time and we delete the access we saved.</p>
  </section>
</div>
