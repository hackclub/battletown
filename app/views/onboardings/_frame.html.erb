<%# locals: (step:, title: nil, encouragement: nil) -%>
<%# Shared chrome for every step: a round back button and the progress bar across the top, then the heading, the
    saved prize and the step itself. @transition (set by the controller) plays
    a short full-screen moment over the step (the welcome splash, or "others like you" after the prize and project
    steps) that fades away by itself. %>
<% copy = onboarding_copy(step) %>
<% index = OnboardingsController::STEPS.index(step) %>
<% total = OnboardingsController::STEPS.size %>
<% editing = current_user&.onboarded? %>
<% content_for :title, title || copy[:title] %>
<%# The progress strip (bar, logo, sign in) is the top of the page: no site header and no footer. %>
<% content_for :hide_site_header, true %>
<% content_for :hide_footer, true %>
<% content_for :flash_in_page, true %>

<section class="container onboarding-page" data-controller="onboarding-step<%= " onboarding-transition" if @transition %>"
         <% if @transition %>data-action="keydown@window->onboarding-transition#skip turbo:before-cache@document->onboarding-transition#skip"<% end %>>
  <%= render "onboardings/transition", kind: @transition if @transition %>

  <div class="onboarding-page__content stack <%= "transition-enter" if @transition %>">
    <%# Kept in place by Turbo between steps (data-turbo-permanent): the onboarding-top controller moves its bar to the new step's value, so the fill slides instead of being redrawn. The count and the step's name are for screen readers only. %>
    <div class="onboarding-top" id="onboarding-top" data-turbo-permanent data-controller="onboarding-top"
         data-action="turbo:before-render@document->onboarding-top#prepare turbo:render@document->onboarding-top#update">
      <progress class="onboarding-top__bar" max="<%= total %>" value="<%= index + 1 %>" aria-labelledby="onboarding-progress-label" aria-describedby="onboarding-progress-step">Step <%= index + 1 %> of <%= total %>: <%= copy[:label] %></progress>
      <div class="visually-hidden">
        <span class="onboarding-top__label" id="onboarding-progress-label"><%= editing ? "editing your plan" : copy[:progress] %></span>
        <span class="onboarding-top__step" id="onboarding-progress-step">Step <%= index + 1 %> of <%= total %></span>
      </div>
      <div class="onboarding-top__row">
        <span aria-hidden="true"></span>
        <%= link_to root_path, class: "onboarding-top__logo" do %><%= image_tag "design/logo.svg", alt: "", width: 75, height: 44 %><span class="visually-hidden">Battletown</span><% end %>
        <div class="onboarding-top__side">
          <% unless signed_in? %>
            <%# Turbo is off: the OmniAuth redirect goes cross-origin. %>
            <%= button_to "Sign in", "/auth/hack_club", method: :post, class: "onboarding-top__signin", form: { class: "onboarding-top__signin-form", data: { turbo: false } } %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="onboarding stack">
      <div class="onboarding__panel">
        <%# The transition's message, for screen readers and for people who have motion turned down (CSS shows it only then). %>
        <% if @transition == "welcome" %>
          <p class="onboarding-note">Welcome to Battletown. Make projects, take down the boss, get gear.</p>
        <% elsif @transition %>
          <p class="onboarding-note"><%= onboarding_proof(@transition)[:headline] %></p>
        <% end %>

        <%# The celebration shows the prize in its own summary. %>
        <% if index.positive? && index < total - 1 && (prize = onboarding_saved_prize) %>
          <p class="onboarding-prize">
            <span class="onboarding-prize__label">Working toward</span>
            <strong><% if prize.image.present? %><%= image_tag prize.image, alt: "", class: "onboarding-prize__image" %><% end %><%= prize.name %></strong>
            <span class="onboarding-prize__hours"><%= onboarding_hours_text(prize) %></span>
          </p>
        <% end %>

        <%# What happened on the way here (for example after Hackatime): inside the step, announced and focused, because the
            layout's own flash sits before the main content and would be skipped when focus moves to the heading. %>
        <% flash.each do |type, message| %>
          <p class="alert alert--<%= type == "alert" ? "danger" : "success" %> onboarding__flash" role="<%= type == "alert" ? "alert" : "status" %>" tabindex="-1" data-onboarding-step-target="errors"><%= message %></p>
        <% end %>

        <header class="onboarding__header">
          <h1 tabindex="-1" data-onboarding-step-target="heading"><span class="onboarding__title"><%= title || copy[:title] %></span></h1>
          <p class="lead onboarding__encouragement" id="onboarding-lead"><%= encouragement || copy[:encouragement] %></p>
        </header>

        <%= yield %>
      </div>
    </div>
  </div>
</section>
