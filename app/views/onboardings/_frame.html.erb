<%# Shared chrome for every step: progress, saved prize, heading, encouragement and a back link. %>
<% copy = onboarding_copy(step) %>
<% index = OnboardingsController::STEPS.index(step) %>
<% content_for :title, copy[:title] %>

<section class="container onboarding" data-controller="onboarding-step">
  <nav class="onboarding-progress" aria-label="Onboarding progress" data-step="<%= index + 1 %>">
    <div class="onboarding-progress__track" aria-hidden="true"><div class="onboarding-progress__fill"></div></div>
    <ol class="onboarding-progress__steps">
      <% OnboardingsController::STEPS.each_with_index do |slug, i| %>
        <% reachable = i <= current_user.onboarding_step && !(slug == "celebrate" && current_user.onboarded?) %>
        <li class="onboarding-progress__step <%= "onboarding-progress__step--done" if i < index %> <%= "onboarding-progress__step--current" if i == index %>">
          <% if i == index %>
            <span aria-current="step"><span class="onboarding-progress__num"><%= i + 1 %></span> <%= onboarding_copy(slug)[:label] %></span>
          <% elsif reachable %>
            <%= link_to onboarding_step_path(slug) do %><span class="onboarding-progress__num"><%= i + 1 %></span> <%= onboarding_copy(slug)[:label] %><% end %>
          <% else %>
            <span><span class="onboarding-progress__num"><%= i + 1 %></span> <%= onboarding_copy(slug)[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <% if index.positive? && (prize = onboarding_saved_prize) %>
    <p class="onboarding-prize" aria-label="Your chosen prize">
      <span class="onboarding-prize__label">Working toward</span>
      <strong><%= prize.emoji %> <%= prize.name %></strong>
      <span class="onboarding-prize__hours"><%= prize.hours_text %></span>
    </p>
  <% end %>

  <header class="onboarding__header">
    <h1 tabindex="-1" data-onboarding-step-target="heading"><%= copy[:title] %></h1>
    <p class="onboarding__encouragement"><%= copy[:encouragement] %></p>
  </header>

  <div class="card onboarding__card">
    <%= yield %>
  </div>

  <% if index.positive? && index < OnboardingsController::STEPS.size - 1 %>
    <p class="onboarding__back"><%= link_to "← Back", onboarding_step_path(OnboardingsController::STEPS[index - 1]) %></p>
  <% end %>
</section>
