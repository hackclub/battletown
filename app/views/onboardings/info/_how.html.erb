<%# The four steps as numbered flat tiles, each with a small drawing, appearing in order (CSS only, shown whole when motion is reduced). Drawings are on a 48-unit box with the shape centered in it. %>
<ol class="how">
  <li class="how__step">
    <span class="how__num" aria-hidden="true">1</span>
    <svg class="how__art" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <rect class="how__navy" x="6" y="8" width="36" height="26" rx="4"/>
      <path class="how__line" d="M16 15l6 6-6 6M25 27h7"/>
      <path class="how__blue" d="M4 38h40v1a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"/>
    </svg>
    <span class="how__text">Code, with Hackatime counting the time.</span>
  </li>
  <li class="how__step">
    <span class="how__num" aria-hidden="true">2</span>
    <svg class="how__art" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <path class="how__blue" d="M5 22L43 5 26 43 21 27z"/>
      <path class="how__blue-edge" d="M21 27L43 5 24 33z"/>
    </svg>
    <span class="how__text">Ship your project.</span>
  </li>
  <li class="how__step">
    <span class="how__num" aria-hidden="true">3</span>
    <svg class="how__art" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <ellipse class="how__yellow-edge" cx="24" cy="38" rx="15" ry="6"/>
      <ellipse class="how__yellow" cx="24" cy="34" rx="15" ry="6"/>
      <ellipse class="how__yellow-edge" cx="24" cy="26" rx="15" ry="6"/>
      <ellipse class="how__yellow" cx="24" cy="22" rx="15" ry="6"/>
      <ellipse class="how__yellow-edge" cx="24" cy="14" rx="15" ry="6"/>
      <ellipse class="how__yellow" cx="24" cy="10" rx="15" ry="6"/>
    </svg>
    <span class="how__text">Its hours turn into coins.</span>
  </li>
  <li class="how__step">
    <span class="how__num" aria-hidden="true">4</span>
    <svg class="how__art" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <rect class="how__blue" x="7" y="21" width="34" height="21" rx="3"/>
      <rect class="how__blue-edge" x="5" y="14" width="38" height="9" rx="3"/>
      <rect class="how__yellow" x="21" y="14" width="6" height="28"/>
      <ellipse class="how__yellow" cx="18" cy="9" rx="6" ry="4.5"/>
      <ellipse class="how__yellow" cx="30" cy="9" rx="6" ry="4.5"/>
    </svg>
    <span class="how__text">Coins pay for your prize.</span>
  </li>
</ol>
