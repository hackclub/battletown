<%# A small flat drawing of the kind of project (game, website, app, tool or bot) above the sentence. Drawn on a 96-unit box, each shape centered in it;
    it pops in once (CSS only, final state when motion is reduced). The prize is the docked picture, so none here. %>
<% kind = answers.kind %>
<svg class="kind" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <g class="kind__art">
    <% case kind %>
    <% when "website" %>
      <rect class="kind__navy" x="10" y="16" width="76" height="64" rx="8"/>
      <rect class="kind__white" x="14" y="30" width="68" height="46" rx="4"/>
      <circle class="kind__yellow" cx="21" cy="23" r="2.5"/><circle class="kind__yellow" cx="29" cy="23" r="2.5"/>
      <rect class="kind__blue" x="20" y="36" width="56" height="11" rx="2"/>
      <rect class="kind__edge" x="20" y="53" width="33" height="16" rx="2"/><rect class="kind__edge" x="58" y="53" width="18" height="16" rx="2"/>
    <% when "app" %>
      <rect class="kind__navy" x="27" y="8" width="42" height="80" rx="10"/>
      <rect class="kind__white" x="32" y="18" width="32" height="58" rx="3"/>
      <rect class="kind__blue" x="36" y="24" width="24" height="14" rx="3"/>
      <rect class="kind__edge" x="36" y="43" width="24" height="7" rx="3"/><rect class="kind__edge" x="36" y="55" width="16" height="7" rx="3"/>
    <% when "tool" %>
      <rect class="kind__navy" x="10" y="18" width="76" height="60" rx="8"/>
      <path class="kind__line" d="M26 38l12 10-12 10M46 58h24"/>
    <% else %>
      <path class="kind__navy" d="M30 28h36c13 0 22 9 22 28v6c0 6-4 10-9 10-4 0-7-3-9-6l-5-8H31l-5 8c-2 3-5 6-9 6-5 0-9-4-9-10v-6c0-19 9-28 22-28z"/>
      <path class="kind__line" d="M30 44v14M23 51h14"/>
      <circle class="kind__yellow" cx="64" cy="46" r="4"/><circle class="kind__blue" cx="73" cy="55" r="4"/>
    <% end %>
  </g>
</svg>
<p class="info__line">Every hour you code on it turns into coins once you ship<%= answers.prize ? safe_join([ ", toward your ", tag.span(answers.prize.name, class: "nowrap") ]) : "" %>.</p>
