<%# Today and then: a winding path of stepping stones. You stand on the first stone today; the prize waits on the last one, on the day the pace screen
    computed. The picture is the real prize, once, on the page (never in a container). Two drawings of the same path (wide, and taller for a phone) share
    the HTML on top of them; where things stand comes from the stylesheet, and the motion is CSS only (off under reduced motion). %>
<% prize = answers.prize %>
<% phrase = onboarding_project_phrase || "Your project" %>
<% date = (Onboarding::Story.date_text(onboarding_prize_date) if prize) %>
<%# Stone centers and sizes in each drawing's own units: [x, y, rx, ry, edge depth]. Stones are spaced with equal edge gaps; the path runs from the first stone's center to the last's. %>
<% shapes = {
     wide: { box: "0 0 400 189", stroke: 16, path: "M38.0 163.3 C48.8 159.0 81.1 137.2 102.7 137.2 C124.2 137.2 145.8 163.3 167.3 163.3 C188.9 163.3 205.8 147.7 232.0 137.2 C258.1 126.6 308.7 106.2 324.0 100.0",
             stones: [ [ 38.0, 163.3, 24, 10.1, 7 ], [ 102.7, 137.2, 24, 10.1, 7 ], [ 167.3, 163.3, 24, 10.1, 7 ], [ 232.0, 137.2, 24, 10.1, 7 ], [ 324.0, 100.0, 62, 26.0, 10 ] ] },
     tall: { box: "0 0 240 370", stroke: 13, path: "M73.5 343.6 C90.2 336.1 174.0 313.8 174.0 298.8 C174.0 283.9 73.5 269.0 73.5 254.1 C73.5 239.2 166.6 234.3 174.0 209.3 C181.4 184.3 127.3 121.6 118.0 104.0",
             stones: [ [ 73.5, 343.6, 22, 8.4, 6 ], [ 174.0, 298.8, 22, 8.4, 6 ], [ 73.5, 254.1, 22, 8.4, 6 ], [ 174.0, 209.3, 22, 8.4, 6 ], [ 118.0, 104.0, 74, 28.1, 9 ] ] }
   } %>
<div class="summary">
  <div class="trail" role="img" aria-label="<%= "You today, and your #{prize&.name} on #{date}" if prize %>">
    <% shapes.each do |name, shape| %>
      <svg class="trail__svg trail__svg--<%= name %>" viewBox="<%= shape[:box] %>" aria-hidden="true" focusable="false">
        <path class="trail__path" d="<%= shape[:path] %>" pathLength="1" stroke-width="<%= shape[:stroke] %>"/>
        <% shape[:stones].each_with_index do |(x, y, rx, ry, edge), i| %>
          <g class="trail__stone trail__stone--<%= i + 1 %>">
            <ellipse class="trail__edge" cx="<%= x %>" cy="<%= y + edge %>" rx="<%= rx %>" ry="<%= ry %>"/>
            <ellipse class="trail__top" cx="<%= x %>" cy="<%= y %>" rx="<%= rx %>" ry="<%= ry %>"/>
          </g>
        <% end %>
      </svg>
    <% end %>

    <span class="trail__today">Today</span>
    <span class="trail__you">
      <svg class="trail__pin" viewBox="0 0 24 34" aria-hidden="true" focusable="false"><path class="trail__pin-body" d="M12 33 C 12 33 2 21 2 12 A10 10 0 0 1 22 12 C 22 21 12 33 12 33 Z"/><circle class="trail__pin-dot" cx="12" cy="12" r="4"/></svg>
      <span class="visually-hidden">You</span>
    </span>
    <% if prize %>
      <div class="trail__prize">
        <span class="trail__date"><%= date %></span>
        <% if prize.image.present? %>
          <span class="trail__picture"><span class="choice__crop" data-controller="prize-crop"><%= image_tag prize.image, alt: prize.name, class: "choice__image", data: { prize_crop_target: "image" } %></span></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <%# The next seven days: the pace each coding day, today marked, and the day this week's boss ends when it falls inside them. %>
  <% minutes = onboarding_pace_minutes %>
  <% usual = OnboardingStoryHelper::COMING_WHEN[answers["coding_when"]] %>
  <ol class="week week--<%= onboarding_bar_step(minutes) %>" aria-label="<%= [ usual, "#{pace_text(minutes)} a day" ].compact.join(", ") %>">
    <% onboarding_week.each do |day| %>
      <li class="week__day<%= " week__day--today" if day[:today] %><%= " week__day--boss" if day[:boss_end] %>">
        <span class="week__flag" aria-hidden="true"><% if day[:boss_end] %><svg viewBox="0 0 16 20" focusable="false"><path class="week__pole" d="M3 2v17"/><path class="week__cloth" d="M3 3h11l-3 4 3 4H3z"/></svg><% end %></span>
        <span class="week__well" aria-hidden="true"><% if day[:coding] %><span class="week__bar week__bar--<%= onboarding_bar_step(minutes) %>"></span><% end %></span>
        <span class="week__mins" aria-hidden="true"><%= day[:coding] ? minutes : "" %></span>
        <span class="week__name"><%= day[:short] %></span>
        <span class="visually-hidden"><%= day[:long] %><%= ", today" if day[:today] %>: <%= day[:coding] ? "#{pace_text(minutes)}" : "rest" %><%= ", this week's boss ends" if day[:boss_end] %></span>
      </li>
    <% end %>
  </ol>
  <p class="week__caption"><%= [ usual, "#{pace_text(minutes)} a day" ].compact.join(", ") %></p>
  <p class="info__line"><%= phrase %>, shipped. <%= prize&.hours_text %> coded.</p>
</div>
