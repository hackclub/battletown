<% prize = answers.prize %>
<% phrase = onboarding_project_phrase || "Your project" %>
<div class="summary">
  <%= render "onboardings/info/prize", prize: prize %>
  <div class="summary__cols">
    <section class="summary__col" aria-label="Today">
      <h2 class="summary__head">Today</h2>
      <p>No prize yet</p>
      <p><%= phrase %></p>
      <p>0 hours</p>
    </section>
    <section class="summary__col" aria-label="<%= Onboarding::Story.date_text(onboarding_prize_date) if prize %>">
      <h2 class="summary__head"><%= Onboarding::Story.date_text(onboarding_prize_date) if prize %></h2>
      <p><%= prize&.name %></p>
      <p><%= phrase %>, shipped</p>
      <p><%= prize&.hours_text %> coded</p>
    </section>
  </div>
</div>
