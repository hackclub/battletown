<%# The halfway screen: a flat badge that pops in (a rosette with a half-filled disc), then their prize and its hours. Where it sits is computed by Onboarding::Flow.visible. %>
<% prize = answers.prize %>
<svg class="medal" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <g class="medal__pop">
    <polygon class="medal__edge" points="<%= (0...24).map { |i| a = i * Math::PI / 12; r = i.even? ? 46 : 39; "#{(48 + r * Math.sin(a)).round(2)},#{(52 - r * Math.cos(a)).round(2)}" }.join(" ") %>"/>
    <polygon class="medal__face" points="<%= (0...24).map { |i| a = i * Math::PI / 12; r = i.even? ? 46 : 39; "#{(48 + r * Math.sin(a)).round(2)},#{(48 - r * Math.cos(a)).round(2)}" }.join(" ") %>"/>
    <circle class="medal__disc" cx="48" cy="48" r="24"/>
    <path class="medal__half" d="M48 24a24 24 0 0 1 0 48z"/>
  </g>
</svg>
<% if prize %>
  <p class="info__line medal__line"><%= prize.name %>, <%= onboarding_hours_text(prize) %> of coding.</p>
<% end %>
