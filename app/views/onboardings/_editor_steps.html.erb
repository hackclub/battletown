<%# The editor question and the setup steps for the chosen editor. Steps are Hackatime's own (see OnboardingsHelper::HACKATIME_EDITORS);
    the choice is kept in the browser only. Without JavaScript every editor's steps show. %>
<section class="editor" data-controller="onboarding-editor" data-action="change->onboarding-editor#choose" aria-labelledby="editor-question">
  <fieldset class="onboarding__fieldset">
    <legend class="onboarding__legend" id="editor-question">Which editor do you use?</legend>
    <%= render "onboardings/choice_group", name: "editor", auto: false, input_data: { onboarding_editor_target: "choice" },
          options: OnboardingsHelper::HACKATIME_EDITORS.map { |editor| { value: editor[:key], label: editor[:name], id: "editor_#{editor[:key]}", checked: false } } +
                   [ { value: "other", label: "Something else", id: "editor_other", checked: false, apart: true } ] %>
  </fieldset>

  <% OnboardingsHelper::HACKATIME_EDITORS.each do |editor| %>
    <div class="editor__steps card card--cream card--flat" data-editor="<%= editor[:key] %>" data-onboarding-editor-target="panel" id="editor-steps-<%= editor[:key] %>">
      <h2 class="check__title">Set up <%= editor[:name] %></h2>
      <ol>
        <li><%= link_to "Open Hackatime's setup page", OnboardingsHelper::HACKATIME_SETUP_URL, target: "_blank", rel: "noopener noreferrer" %> and follow it.</li>
        <% editor[:steps].each_with_index do |text, index| %>
          <li><%= text %><% if editor[:code] && index.zero? %><code class="editor__code"><%= editor[:code] %></code><% end %></li>
        <% end %>
      </ol>
      <p class="muted small"><%= link_to "Hackatime's guide for #{editor[:name]}", editor[:url], target: "_blank", rel: "noopener noreferrer" %></p>
    </div>
  <% end %>
  <div class="editor__steps card card--cream card--flat" data-editor="other" data-onboarding-editor-target="panel" id="editor-steps-other">
    <h2 class="check__title">Set up another editor</h2>
    <ol>
      <li><%= link_to "Open Hackatime's setup page", OnboardingsHelper::HACKATIME_SETUP_URL, target: "_blank", rel: "noopener noreferrer" %> and follow it.</li>
      <li>Find your editor in <%= link_to "Hackatime's editor guides", OnboardingsHelper::HACKATIME_EDITOR_GUIDES_URL, target: "_blank", rel: "noopener noreferrer" %> and follow its steps.</li>
    </ol>
  </div>
</section>
