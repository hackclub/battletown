<%# locals: (kind:) -%>
<%# A full-screen moment over a step: the welcome splash ("welcome") or the "others like you" message after the prize
    ("prize") and project ("project") steps. All timing is CSS (see onboarding.css); the transition controller only lets
    people skip it (a click, or any key except browser shortcuts). Hidden from assistive tech on purpose: the frame says the same
    thing in .onboarding-note, so a screen reader hears it once, in the page, and not twice. The words are plain (no arrows),
    so they read the same with the pictures gone. %>
<% proof = kind == "welcome" ? nil : onboarding_proof(kind) %>
<div class="transition transition--<%= kind == "welcome" ? "welcome" : "proof" %>" data-turbo-temporary data-onboarding-transition-target="overlay"
     data-action="click->onboarding-transition#skip" aria-hidden="true">
  <%= image_tag "landing/hero-art-1920.webp", alt: "", class: "transition__art", srcset: hero_art_srcset, sizes: "100vw", width: 1920, height: 1236 %>
  <div class="transition__body">
    <% if proof %>
      <% prize = proof[:prize] %>
      <div class="transition__badge">
        <% if prize&.image.present? %>
          <%= image_tag prize.image, alt: "", class: "transition__badge-image" %>
        <% else %>
          <span class="transition__badge-emoji"><%= prize ? prize.emoji : proof[:emoji] %></span>
        <% end %>
      </div>
      <p class="transition__title"><%= proof[:headline] %></p>
      <p class="transition__sub"><%= proof[:body] %></p>
    <% else %>
      <p class="transition__kicker">Welcome to</p>
      <%= image_tag "design/logo.svg", alt: "", class: "transition__logo", width: 579, height: 329 %>
      <p class="transition__title">Make projects, take down the boss, get gear</p>
    <% end %>
    <p class="transition__hint">Click anywhere to skip</p>
  </div>
</div>
