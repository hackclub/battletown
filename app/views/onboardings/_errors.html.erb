<%# Error summary: announced on render (role=alert) and focused by onboarding-step; each line links to its field. %>
<% errors = onboarding_errors %>
<% if errors.any? %>
  <div class="alert alert--danger onboarding__errors" role="alert" tabindex="-1" data-onboarding-step-target="errors">
    <p class="alert__title">Let's fix a couple of things:</p>
    <ul>
      <% errors.each do |attribute, message| %>
        <li>
          <% if (anchor = onboarding_error_anchor(attribute)) %>
            <a href="#<%= anchor %>"><%= message %></a>
          <% else %>
            <%= message %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
