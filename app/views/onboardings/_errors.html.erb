<%# Error summary for the onboarding steps: the shared box, fed with this step's lines. The onboarding-step controller focuses it. %>
<% errors = onboarding_errors %>
<% if errors.any? %>
  <%= render "shared/error_summary", title: "Let's fix a couple of things:", focus: false, data: { onboarding_step_target: "errors" },
        items: errors.map { |attribute, message| [ message, onboarding_error_anchor(attribute) ] } %>
<% end %>
