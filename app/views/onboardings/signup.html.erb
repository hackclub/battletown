<%= render layout: "onboardings/frame", locals: { step: "signup" } do %>
  <%= render "onboardings/summary", subject: subject %>
  <ul class="checks">
    <li class="check"><p>Signing in with Hack Club takes a few seconds and gets you a free sticker.</p></li>
  </ul>
  <div class="onboarding__actions">
    <%= render "shared/signup_button", label: "Sign up with Hack Club", css: "btn btn--primary btn--lg" %>
  </div>
  <p class="onboarding__hint">By signing up you agree to <%= legal_link %>.</p>
<% end %>
