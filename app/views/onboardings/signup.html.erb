<%= render layout: "onboardings/frame", locals: { step: "signup", show_prize: false } do %>
  <div class="reveal">
    <%= render "onboardings/summary", subject: subject %>
    <%= render "onboardings/boss", boss: onboarding_boss %>
  </div>
  <ul class="checks">
    <li class="check"><p>Signing in with Hack Club takes a few seconds and gets you a free sticker.</p></li>
  </ul>
  <div class="onboarding__actions">
    <%= render "shared/signup_button", label: "Sign up with Hack Club", css: "btn btn--primary btn--lg" %>
  </div>
  <p class="onboarding__hint">By signing up you agree to the <%= link_to "Terms", terms_path %> and the <%= link_to "Privacy Policy", privacy_path %>.</p>
<% end %>
