  <%= form_with model: subject, scope: :user, url: onboarding_step_path("schedule"), method: :patch, data: { controller: "timezone onboarding-times required-choice", action: "change->onboarding-times#sync change->required-choice#sync submit->required-choice#guard" } do |f| %>
    <%= render "onboardings/errors" %>
    <%= tag.fieldset class: "field onboarding__fieldset", aria: onboarding_aria(:coding_days, id: "days").slice(:describedby) do %>
      <legend class="onboarding__legend">Which days do you want to code?</legend>
      <%= onboarding_field_error(:coding_days, id: "days") %>
      <div class="days toggle-group" data-controller="onboarding-days" data-action="change->onboarding-days#sync">
        <% User::DAYS.each do |day| %>
          <label class="day toggle">
            <%= check_box_tag "user[coding_day_names][]", day, subject.coding_day_names.include?(day), id: "user_day_#{day}", class: "day__input toggle__input", data: { onboarding_days_target: "day", onboarding_times_target: "day", required_choice_target: "input" } %>
            <span class="day__label toggle__label"><span aria-hidden="true"><%= day_label(day).first(3) %></span><span class="visually-hidden"><%= day_label(day) %></span></span>
          </label>
        <% end %>
        <%# Revealed by onboarding-days; without JS the pills above work on their own. %>
        <button type="button" class="day-all" hidden aria-pressed="<%= subject.coding_days == 127 %>" data-onboarding-days-target="all" data-action="onboarding-days#toggleAll onboarding-times#sync required-choice#sync">Every day</button>
      </div>
    <% end %>

    <div class="onboarding__pair">
    <div class="field onboarding__field <%= "field--invalid" if onboarding_errors(:coding_time).any? %>">
      <%= f.label :coding_time, "What time works best?" %>
      <%= f.time_field :coding_time, value: subject.coding_time || "18:00", aria: onboarding_aria(:coding_time, id: "user_coding_time") %>
      <%= onboarding_field_error(:coding_time, id: "user_coding_time") %>
    </div>

    <div class="field onboarding__field <%= "field--invalid" if onboarding_errors(:pace_minutes).any? %>">
      <%= f.label :pace_minutes, "How long will you code on those days?" %>
      <%= f.select :pace_minutes, pace_options, { selected: subject.pace }, aria: onboarding_aria(:pace_minutes, id: "user_pace_minutes", hint: "pace-hint") %>
      <p class="field__hint" id="pace-hint">This is the pace your prize check on the dashboard uses. You can change it any time.</p>
      <%= onboarding_field_error(:pace_minutes, id: "user_pace_minutes") %>
    </div>
    </div>

    <%# Optional: a different time on some days. Without JS all seven rows show; onboarding-times hides the unselected days. %>
    <div class="onboarding__pair onboarding__pair--extras">
    <details class="day-times onboarding__field" <%= "open" if subject.coding_times.any? || subject.errors.key?(:coding_times) %>>
      <summary class="day-times__summary">Different time on some days? <span class="day-times__change">Set times by day</span></summary>
      <div class="day-times__body field <%= "field--invalid" if onboarding_errors(:coding_times).any? %>">
        <p class="field__hint" id="day-times-hint">Optional. Leave a day empty to use the time above.</p>
        <%= onboarding_field_error(:coding_times, id: "day-times") %>
        <% User::DAYS.each do |day| %>
          <div class="day-times__row" data-onboarding-times-target="row" data-day="<%= day %>">
            <%= label_tag "user_coding_times_#{day}", class: "day-times__label" do %><%= day_label(day) %> <span class="day-times__optional">(optional)</span><% end %>
            <%= time_field_tag "user[coding_times][#{day}]", subject.coding_times[day], id: "user_coding_times_#{day}",
                  aria: onboarding_aria(:coding_times, id: "day-times", hint: "day-times-hint") %>
          </div>
        <% end %>
      </div>
    </details>

    <%# The time zone is derived from the address at sign-in; the select is tucked away but still submits with the form. %>
    <% zone = onboarding_time_zone %>
    <details class="timezone onboarding__field" data-timezone-target="details" <%= "open" if zone.nil? || subject.errors.key?(:time_zone) %>>
      <summary class="timezone__summary">
        <% if zone %>
          We'll use <strong data-timezone-target="name"><%= zone.name %></strong> for your reminders. Not right? <span class="timezone__change">Change time zone</span>
        <% else %>
          Which time zone are you in? <span class="timezone__change">Choose time zone</span>
        <% end %>
      </summary>
      <div class="timezone__body field <%= "field--invalid" if onboarding_errors(:time_zone).any? %>">
        <%= f.label :time_zone, "Your time zone" %>
        <%= f.select :time_zone, time_zone_options, { include_blank: "Choose your time zone" },
              aria: onboarding_aria(:time_zone, id: "user_time_zone"), data: { timezone_target: "select", action: "timezone#update" } %>
        <%= onboarding_field_error(:time_zone, id: "user_time_zone") %>
      </div>
    </details>
    </div>

    <p class="field__hint onboarding__note">We'll remind you with a Slack DM on your coding days. No email or phone number needed.</p>
    <% if signed_in? && current_user.slack_id.blank? %>
      <p class="alert alert--warning onboarding__note" role="note">Your Hack Club account isn't linked to a Slack account yet, so we can't DM you. Your plan is saved for when it is.</p>
    <% end %>
    <%# TODO: SMS reminders, pending a privacy decision. %>
    <div class="onboarding__actions"><%= f.button "Continue", class: "btn btn--primary btn--lg", data: { required_choice_target: "submit" }, aria: { describedby: "onboarding-lead" } %></div>
  <% end %>
