<%= render layout: "onboardings/frame", locals: { step: "prize", tone: "blue" } do %>
  <%= form_with model: subject, scope: :user, url: onboarding_step_path("prize"), method: :patch,
        data: { controller: "required-choice", action: "change->required-choice#sync submit->required-choice#guard" } do |f| %>
    <%= render "onboardings/errors" %>
    <%= tag.fieldset class: "onboarding__fieldset", aria: onboarding_aria(:prize_key, id: "prize").slice(:describedby) do %>
      <legend class="visually-hidden">Prize</legend>
      <%= onboarding_field_error(:prize_key, id: "prize") %>
      <div class="choice-grid choice-grid--prizes">
        <% selected = onboarding_prize_selection %>
        <% Prize.paid.each do |prize| %>
          <label class="choice">
            <%# radio_button_tag keeps the radio directly before its card body (the "input + body" styling); the builder would add an association-based id and error handling we do not need. %>
            <%= radio_button_tag "user[prize_key]", prize.key, prize.key == selected, id: "user_prize_key_#{prize.key}", class: "choice__input", data: { required_choice_target: "input" } %>
            <span class="choice__body">
              <span class="choice__art">
                <% if prize.image.present? %>
                  <%= image_tag prize.image, alt: "", class: "choice__image" %>
                <% else %>
                  <span class="choice__emoji" aria-hidden="true"><%= prize.emoji %></span>
                <% end %>
              </span>
              <span class="choice__plate">
                <span class="choice__name"><%= prize.name %></span>
                <span class="choice__meta"><%= onboarding_hours_text(prize) %></span>
                <span class="choice__desc"><%= prize.description %></span>
              </span>
            </span>
          </label>
        <% end %>
      </div>
      <p class="onboarding__hint onboarding__hint--light"><%= OnboardingDesignHelper::HOURS_NOTE %></p>
    <% end %>
    <div class="onboarding__actions"><%= f.button "Continue", class: "btn btn--primary btn--lg", data: { required_choice_target: "submit" }, aria: { describedby: "onboarding-lead" } %></div>
  <% end %>
<% end %>
