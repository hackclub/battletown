<%= render layout: "onboardings/frame", locals: { step: "prize" } do %>
  <%= form_with model: subject, scope: :user, url: onboarding_step_path("prize"), method: :patch,
        data: { controller: "prize-flight", action: "submit->prize-flight#record" } do |f| %>
    <%= render "onboardings/errors" %>
    <%= tag.fieldset class: "onboarding__fieldset", aria: onboarding_aria(:prize_key, id: "prize").slice(:describedby) do %>
      <legend class="visually-hidden">Prize</legend>
      <%= onboarding_field_error(:prize_key, id: "prize") %>
      <% selected = onboarding_prize_selection %>
      <%= render "onboardings/choice_group", layout: :cards, name: "user[prize_key]", options: Prize.paid.map { |prize|
            { value: prize.key, label: prize.name, id: "user_prize_key_#{prize.key}", checked: prize.key == selected, image: prize.image,
              meta: onboarding_hours_text(prize), desc: prize.description } } %>
    <% end %>
  <% end %>
<% end %>
