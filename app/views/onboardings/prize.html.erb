<%= render layout: "onboardings/frame", locals: { step: "prize" } do %>
  <%= form_with model: current_user, scope: :user, url: onboarding_step_path("prize"), method: :patch do |f| %>
    <%= render "onboardings/errors" %>
    <%= tag.fieldset class: "onboarding__fieldset", aria: onboarding_aria(:prize_key, id: "prize").slice(:describedby) do %>
      <legend class="visually-hidden">Prize</legend>
      <%= onboarding_field_error(:prize_key, id: "prize") %>
      <div class="choice-grid choice-grid--prizes">
        <% selected = onboarding_prize_selection %>
        <% Prize.paid.each do |prize| %>
          <label class="choice">
            <%# radio_button_tag, not f.radio_button: the form builder wraps an invalid field in a div, which would break the "input + body" styling. %>
            <%= radio_button_tag "user[prize_key]", prize.key, prize.key == selected, id: "user_prize_key_#{prize.key}", class: "choice__input" %>
            <span class="choice__body">
              <span class="choice__art">
                <% if prize.image.present? %>
                  <%= image_tag prize.image, alt: "", class: "choice__image" %>
                <% else %>
                  <span class="choice__emoji" aria-hidden="true"><%= prize.emoji %></span>
                <% end %>
              </span>
              <span class="choice__name"><%= prize.name %></span>
              <span class="choice__meta"><%= prize.hours_text %></span>
              <span class="choice__desc"><%= prize.description %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% end %>
    <div class="onboarding__actions"><%= f.button "Continue", class: "btn btn--primary btn--lg" %></div>
  <% end %>
<% end %>
