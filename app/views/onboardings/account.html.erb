<%= render layout: "onboardings/frame", locals: { step: "account" } do %>
  <%# Hackatime is required: it is how coding time counts. It sits outside the form below because connecting is its own
      form (a POST to Hackatime); the form holds the rest of the step and the Continue button. %>
  <% connection = current_user.hackatime_connection %>
  <% state = connection.nil? ? :missing : (connection.needs_reconnect? ? :reconnect : :connected) %>
  <%= render "onboardings/editor_steps" %>

  <ul class="checks">
    <li class="check card card--cream card--flat" id="hackatime-check">
      <div class="check__head">
        <h2 class="check__title">Hackatime</h2>
        <% case state when :connected %>
          <span class="badge badge--success">Connected</span>
        <% when :reconnect %>
          <span class="badge badge--warning">Needs reconnecting</span>
        <% else %>
          <span class="badge badge--warning">Required</span>
        <% end %>
      </div>
      <% if state == :connected %>
        <p>Hackatime is connected. Your coding time will count on its own.</p>
      <% else %>
        <p>Hackatime is the free tool that tracks the time you spend coding. It's how your hours count, so we need it before you start.</p>
        <p class="muted small">You'll go to Hackatime, say yes, and come straight back here. We can only read, never change anything. We use how long you code each day, the names of your Hackatime projects and your Hackatime ID. We don't use or keep anything else, like your email.</p>
        <div class="check__action">
          <%= button_to (state == :reconnect ? "Reconnect Hackatime" : "Connect Hackatime"), "/auth/hackatime", method: :post, class: "btn btn--primary btn--lg", form: { data: { turbo: false } } %>
        </div>
      <% end %>
    </li>
  </ul>

  <%= form_with model: current_user, scope: :user, url: onboarding_step_path("account"), method: :patch do |f| %>
    <%= render "onboardings/errors" %>
    <ul class="checks">
      <li class="check card card--cream card--flat">
        <h2 class="check__title">How you found us</h2>
        <% if current_user.referral_source_in_database.present? %>
          <p><%= referral_summary(current_user.referral_source_in_database) %></p>
        <% else %>
          <div class="field <%= "field--invalid" if onboarding_errors(:referral_source).any? %>">
            <%= f.label :referral_source, "How did you hear about us? (optional)" %>
            <%= f.select :referral_source, referral_source_options, { include_blank: "Skip" }, aria: onboarding_aria(:referral_source, id: "user_referral_source") %>
            <%= onboarding_field_error(:referral_source, id: "user_referral_source") %>
          </div>
        <% end %>
      </li>
    </ul>
    <%# Continue shows once Hackatime works (the server refuses without it too). Someone editing their plan later always has it. %>
    <% if state == :connected || current_user.onboarded? %>
      <div class="onboarding__actions"><%= f.button "Continue", class: "btn btn--primary btn--lg" %></div>
    <% end %>
  <% end %>
<% end %>
