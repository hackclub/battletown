<%= render layout: "onboardings/frame", locals: { step: "age" } do %>
  <%= form_with url: onboarding_step_path("age"), method: :patch, scope: :user do |f| %>
    <%= render "onboardings/choice_group", name: "user[age_group]", options: [
          { value: "teen", label: "I'm a teen aged 13–18!", id: "user_age_group_teen", checked: false },
          { value: "adult", label: "I'm not 13–18", id: "user_age_group_adult", checked: false } ] %>
  <% end %>
<% end %>
