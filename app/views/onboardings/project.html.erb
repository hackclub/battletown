<%= render layout: "onboardings/frame", locals: { step: "project" } do %>
  <%= form_with model: subject, scope: :user, url: onboarding_step_path("project"), method: :patch do |f| %>
    <%= render "onboardings/errors" %>
    <%= tag.fieldset class: "field onboarding__fieldset", aria: onboarding_aria(:project_kind, id: "kind").slice(:describedby) do %>
      <legend class="visually-hidden">What kind of project?</legend>
      <%= onboarding_field_error(:project_kind, id: "kind") %>
      <%= render "onboardings/choice_group", name: "user[project_kind]", options: offered_project_kinds.map { |kind, info|
            { value: kind, label: info[:name], id: "user_project_kind_#{kind}", checked: subject.project_kind == kind, apart: kind == "undecided" } } %>
    <% end %>
  <% end %>
<% end %>
