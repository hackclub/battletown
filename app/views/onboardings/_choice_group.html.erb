<%# locals: (name:, options:, layout: :rows, auto: true, input_data: {}) -%>
<%# THE single-choice question of the onboarding: every step that asks "pick one" (age, prize, project kind, pace, editor) renders through here and
    through one stylesheet block (onboarding_world.css, "Single choice"). Native radios in one group (the browser keeps one pick, restores it on Back and
    moves with the arrow keys); a pick shows only through :checked; with `auto` a pick holds for a beat and sends the form, so there is never a Continue.
    options: [{ value:, label:, id:, checked:, detail: (second line), apart: (the opt-out row), image: (cards), meta:, desc: (cards) }]
    layout: :rows (text options) or :cards (the prize pictures). %>
<div class="choice-grid choice-grid--<%= layout %>">
  <% options.each do |option| %>
    <label class="choice<%= " choice--apart" if option[:apart] %>">
      <%= radio_button_tag name, option[:value], option[:checked], id: option[:id], class: "choice__input",
            data: input_data.merge(auto ? { action: "change->onboarding-step#choose" } : {}) %>
      <% if layout == :cards %>
        <span class="choice__body">
          <span class="choice__art"><% if option[:image].present? %><%= image_tag option[:image], alt: "", class: "choice__image" %><% end %></span>
          <span class="choice__plate">
            <span class="choice__name"><%= option[:label] %></span>
            <span class="choice__meta"><%= option[:meta] %></span>
            <span class="choice__desc"><%= option[:desc] %></span>
          </span>
        </span>
      <% else %>
        <span class="choice__body">
          <span class="choice__name"><%= option[:label] %></span>
          <% if option[:detail].present? %><span class="choice__meta"><%= option[:detail] %></span><% end %>
        </span>
      <% end %>
    </label>
  <% end %>
</div>
<% if auto %><noscript><div class="onboarding__actions"><input type="submit" class="btn btn--primary btn--lg" value="Continue"></div></noscript><% end %>
