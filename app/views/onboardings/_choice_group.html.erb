<%# locals: (name:, options:, layout: :rows, auto: true, input_data: {}, submit: true, multi: false) -%>
<%# THE single-choice question of the onboarding: every step that asks "pick one" (age, prize, project kind, pace, editor) renders through here, on the
    component library's option rows and picture cards (Basecoat, themed in app/assets/tailwind/battletown_theme.css; the `.basecoat` wrapper is in the
    step frame). The `choice*` classes are hooks for scripts and tests only: no stylesheet targets them except the few onboarding additions. Native radios in one group (the browser keeps one pick, restores it on Back and
    moves with the arrow keys); a pick shows only through :checked; with `auto` a pick holds for a beat and sends the form, so there is never a Continue.
    options: [{ value:, label:, id:, checked:, detail: (second line), apart: (the opt-out row), image: (cards), meta:, desc: (cards) }]
    layout: :rows (text options) or :cards (the prize pictures). %>
<div class="basecoat choice-wrap">
<% icons = layout == :cards && options.any? { |option| option[:icon].present? } %>
<div class="<%= layout == :cards ? "option-cards" : "option-list" %><%= " option-cards--icons option-cards--n#{options.size}" if icons %> choice-grid choice-grid--<%= layout %>">
  <% options.each do |option| %>
    <label class="<%= layout == :cards ? "option-card" : "option-row" %> choice<%= " choice--apart" if option[:apart] %><%= " option-row--check" if multi %>">
      <%= (multi ? check_box_tag(name, option[:value], option[:checked], id: option[:id], class: "choice__input", data: input_data) :
            radio_button_tag(name, option[:value], option[:checked], id: option[:id], class: "choice__input",
              data: input_data.merge(auto ? { action: "change->onboarding-step#choose click->onboarding-step#choose" } : {}))) %>
      <% if layout == :cards %>
        <span class="option-card__art choice__art<%= " choice__art--icon" if option[:icon].present? %>"><% if option[:icon].present? %><%= image_tag option[:icon], alt: "", class: "choice__icon" %><% end %><% if option[:image].present? %><span class="choice__crop" data-controller="prize-crop"><%= image_tag option[:image], alt: "", class: "choice__image", data: { prize_crop_target: "image" } %></span><% end %></span>
        <span class="option-card__name choice__name"><%= option[:label] %></span>
        <span class="option-card__note choice__meta"><%= option[:meta] || option[:detail] %></span>
      <% else %>
        <% if multi %><span class="option-row__mark" aria-hidden="true"></span><% end %>
        <span class="choice__name"><%= option[:label] %></span>
        <% if option[:detail].present? %><span class="option-row__note choice__meta"><%= option[:detail] %></span><% end %>
      <% end %>
    </label>
  <% end %>
</div>
</div>
<% if auto && submit %><noscript><div class="onboarding__actions"><input type="submit" class="btn btn--primary btn--lg" value="Continue"></div></noscript><% end %>
