-- The read-only analytics layer (projects/battletown/plans/analytics.md, section 3). ONE idempotent file: Analytics::Views.rebuild! runs it (the
-- insights migration, every schema load of the primary database, `rake insights:rebuild`, and `db:prepare` when its checksum is out of date).
-- Views only, nothing is stored, so a deleted person disappears from every view at once.
--
-- Two schemas:
--   insights_private  one helper view keyed by users.id, never granted to anyone. The only place a view knows both ids.
--   insights          the public contract: every view carries `person_id` (users.analytics_id, a random uuid that is not derived from anything and
--                     dies with the user row) and never users.id, hca_uid, email, display_name, slack_id, time_zone, free text or an address.
-- Staff, simulated players and listed testers (users.analytics_excluded, hca_uid "sim!...", and the live lists ADMIN_HCA_UIDS and
-- ANALYTICS_EXCLUDE_HCA_UIDS, which are rendered into this file so a person added to a list drops out at the next deploy without waiting for their next
-- sign-in) are left out INSIDE insights_private.people, which every other view reads, so a forgotten WHERE cannot leak them. All timestamps are UTC; columns named *_on and local_date are a player's frozen
-- local dates (never mix them with timestamps). Nothing here is ever deleted on a schedule.
DROP SCHEMA IF EXISTS insights CASCADE;
DROP SCHEMA IF EXISTS insights_private CASCADE;
CREATE SCHEMA insights_private;
CREATE SCHEMA insights;

-- ------------------------------------------------------------------------------------------------------------------------------------------
-- Private helpers
-- ------------------------------------------------------------------------------------------------------------------------------------------

-- Who is measured, with the join key.
CREATE VIEW insights_private.people AS
SELECT users.id AS user_id,
       users.analytics_id AS person_id,
       users.created_at AS signed_up_at,
       users.signed_up_on,
       users.onboarded_at
FROM public.users
WHERE <%= measured_sql %>;

-- The game's two numbers the views need, copied from Hours::Config and Game::Config when the file is rendered (a test fails if they disagree).
CREATE VIEW insights.settings AS
SELECT <%= days_before_signup_counted %> AS days_before_signup_counted,
       <%= quick_seconds %> AS quick_seconds;

-- ------------------------------------------------------------------------------------------------------------------------------------------
-- Public views
-- ------------------------------------------------------------------------------------------------------------------------------------------

CREATE VIEW insights.people AS
SELECT people.person_id,
       people.signed_up_at,
       people.signed_up_on,
       people.onboarded_at,
       users.onboarding_step,
       CASE WHEN users.referral_source ~ '^[a-z0-9_-]{1,32}$' THEN users.referral_source END AS referral_source,
       CASE WHEN users.prize_key ~ '^[a-z0-9_]{1,60}$' THEN users.prize_key END AS prize_key,
       users.project_kind,
       COALESCE(btrim(users.project_idea), '') <> '' AS has_idea,
       length(replace(users.coding_days::bit(7)::text, '0', '')) AS coding_days_count,
       users.pace_minutes,
       users.verification_status,
       users.ysws_eligible,
       connections.user_id IS NOT NULL AS hackatime_connected,
       COALESCE(connections.needs_reconnect, FALSE) AS hackatime_needs_reconnect,
       -- When a person first linked Hackatime: the first hackatime_linked event, else the connection (connected_at is overwritten by every reconnect, so
       -- it is only a fallback), else the first hackatime ledger row (a disconnect deletes the connection). NULL when never. One index probe for the
       -- event (a partial index holds just those events), and the ledger is read only for a person with neither.
       COALESCE((SELECT MIN(analytics_events.occurred_at) FROM public.analytics_events WHERE analytics_events.user_id = people.user_id AND analytics_events.name = 'hackatime_linked'),
                connections.connected_at,
                (SELECT MIN(hour_entries.recorded_at) FROM public.hour_entries WHERE hour_entries.user_id = people.user_id AND hour_entries.source = 'hackatime')) AS first_hackatime_linked_at
FROM insights_private.people
JOIN public.users ON users.id = people.user_id
LEFT JOIN public.hackatime_connections connections ON connections.user_id = people.user_id;

-- A browser session: anonymous (person_id NULL) until the person signed in, then theirs. The token is not exposed.
CREATE VIEW insights.visits AS
SELECT visits.id AS visit_id,
       visits.started_at,
       people.person_id,
       visits.referral_slug,
       visits.utm_source,
       visits.utm_medium,
       visits.utm_campaign,
       visits.referrer_kind,
       visits.device_class,
       visits.entry_route
FROM public.analytics_visits visits
LEFT JOIN insights_private.people ON people.user_id = visits.user_id
WHERE visits.user_id IS NULL OR people.user_id IS NOT NULL;

CREATE VIEW insights.events AS
SELECT events.id AS event_id,
       events.occurred_at,
       events.name,
       events.props,
       events.visit_id,
       people.person_id
FROM public.analytics_events events
LEFT JOIN insights_private.people ON people.user_id = events.user_id
WHERE events.user_id IS NULL OR people.user_id IS NOT NULL;

CREATE VIEW insights.site_days AS
SELECT people.person_id, site_days.day
FROM public.analytics_site_days site_days
JOIN insights_private.people ON people.user_id = site_days.user_id;

-- Net ledger seconds per person and local date, and whether the date counts for the game (the same rule as Hours::Days.first_counted_date).
CREATE VIEW insights.hour_days AS
SELECT people.person_id,
       hour_entries.local_date,
       SUM(hour_entries.seconds)::integer AS seconds,
       hour_entries.local_date >= people.signed_up_on - (SELECT settings.days_before_signup_counted FROM insights.settings) AS counted
FROM public.hour_entries
JOIN insights_private.people ON people.user_id = hour_entries.user_id
GROUP BY people.person_id, hour_entries.local_date, people.signed_up_on;

CREATE VIEW insights.daily_results AS
SELECT people.person_id, daily_results.local_date, daily_results.raw_seconds, daily_results.quick_met, daily_results.goal_met,
       daily_results.streak_15, daily_results.goal_streak, daily_results.freeze_used
FROM public.daily_results
JOIN insights_private.people ON people.user_id = daily_results.user_id;

-- No name, idea, URL or to-do text: a Hackatime link count and two booleans.
CREATE VIEW insights.projects AS
SELECT projects.id AS project_id,
       people.person_id,
       projects.created_at,
       projects.kind,
       projects.status,
       projects.review_status,
       (SELECT COUNT(*) FROM public.hackatime_links WHERE hackatime_links.project_id = projects.id) AS linked_hackatime_count,
       projects.repo_url IS NOT NULL AS has_repo,
       projects.demo_url IS NOT NULL AS has_demo
FROM public.projects
JOIN insights_private.people ON people.user_id = projects.user_id;

-- No description, URL, rejection reason, payout note or reviewer.
CREATE VIEW insights.ships AS
SELECT ships.id AS ship_id,
       people.person_id,
       ships.project_id,
       ships.status,
       ships.created_at,
       ships.submitted_at,
       ships.reviewed_at,
       ships.coded_seconds,
       ships.approved_seconds
FROM public.ships
JOIN insights_private.people ON people.user_id = ships.user_id;

-- No address, tracking or note.
CREATE VIEW insights.orders AS
SELECT orders.id AS order_id,
       people.person_id,
       orders.prize_key,
       orders.coins,
       orders.kind,
       orders.status,
       orders.created_at,
       orders.shipped_at,
       orders.fulfilled_at,
       orders.cancelled_at,
       orders.refunded_at
FROM public.orders
JOIN insights_private.people ON people.user_id = orders.user_id;

CREATE VIEW insights.coin_transactions AS
SELECT people.person_id, coin_transactions.kind, coin_transactions.amount, coin_transactions.created_at
FROM public.coin_transactions
JOIN insights_private.people ON people.user_id = coin_transactions.user_id;

CREATE VIEW insights.notifications AS
SELECT people.person_id, notifications.kind, notifications.channel, notifications.status, notifications.scheduled_for, notifications.sent_at,
       notifications.last_error_code
FROM public.notifications
JOIN insights_private.people ON people.user_id = notifications.user_id;

-- The score only, never the comment.
CREATE VIEW insights.nps AS
SELECT people.person_id, nps_responses.score, nps_responses.answered_at
FROM public.nps_responses
JOIN insights_private.people ON people.user_id = nps_responses.user_id;

-- What staff did, per day and action: a count with no actor and no subject (staff are not measured, so there is no one to name).
CREATE VIEW insights.review_actions_daily AS
SELECT actions.day, actions.kind, COUNT(*) AS count
FROM (
  SELECT ships.reviewed_at::date AS day, 'ship_' || ships.status AS kind
  FROM public.ships
  JOIN insights_private.people ON people.user_id = ships.user_id
  WHERE ships.status IN ('approved', 'rejected') AND ships.reviewed_at IS NOT NULL
  UNION ALL
  SELECT project_reviews.created_at::date, 'project_reviewed'
  FROM public.project_reviews
  JOIN public.projects ON projects.id = project_reviews.project_id
  JOIN insights_private.people ON people.user_id = projects.user_id
  UNION ALL
  SELECT order_events.created_at::date, 'order_' || order_events.action
  FROM public.order_events
  JOIN public.orders ON orders.id = order_events.order_id
  JOIN insights_private.people ON people.user_id = orders.user_id
  WHERE order_events.actor_kind = 'staff'
    AND order_events.action IN ('held', 'released', 'shipped', 'fulfilled', 'cancelled', 'refunded')
) actions
GROUP BY actions.day, actions.kind;

-- One row per person with the moment each funnel step was reached (NULL = not yet) and the derived stage. ParticipantFunnel reads only this.
-- A step is reached when (plans/analytics.md, 3.3):
--   signed_up          always (a row in people)
--   onboarded          onboarded_at is set
--   linked_hackatime   a connection exists, or any hackatime ledger row, or a hackatime_linked event (the first of them, as in insights.people)
--   added_project      at least one Hackatime project is linked to a project (the bare project row proves nothing: onboarding creates one)
--   first_active_day   a counted local date with at least the quick threshold (15 minutes) (a DATE: first_active_on)
--   past_5h            counted seconds in total reached 5 hours, the date it did (past_1h_on and past_10h_on are extra "ever reached" marks)
--   shipped            a ship with a submitted_at (a withdrawn one counts: they did ship)
--   approved           a ship was approved
--   bought             an order of kind purchase that is not cancelled (a refunded purchase counts; the free sticker is not a purchase)
-- funnel_stage is the FIRST step not reached (steps happen out of order), or 'completed'; funnel_stage_entered_at is the latest moment among
-- the steps that were reached ("stuck since"). Both are derived here and never stored.
CREATE VIEW insights.funnel_facts AS
SELECT facts.*,
       CASE
         WHEN facts.onboarded_at IS NULL THEN 'onboarded'
         WHEN facts.linked_hackatime_at IS NULL THEN 'linked_hackatime'
         WHEN facts.added_project_at IS NULL THEN 'added_project'
         WHEN facts.first_active_on IS NULL THEN 'first_active_day'
         WHEN facts.past_5h_on IS NULL THEN 'past_5h'
         WHEN facts.shipped_at IS NULL THEN 'shipped'
         WHEN facts.approved_at IS NULL THEN 'approved'
         WHEN facts.bought_at IS NULL THEN 'bought'
         ELSE 'completed'
       END AS funnel_stage,
       GREATEST(facts.signed_up_at, facts.onboarded_at, facts.linked_hackatime_at, facts.added_project_at, facts.first_active_on::timestamp,
                facts.past_5h_on::timestamp, facts.shipped_at, facts.approved_at, facts.bought_at) AS funnel_stage_entered_at
FROM (
  SELECT people.person_id,
         people.signed_up_at,
         people.signed_up_on,
         CASE WHEN users.referral_source ~ '^[a-z0-9_-]{1,32}$' THEN users.referral_source END AS referral_source,
         people.onboarded_at,
         hackatime.at AS linked_hackatime_at,
         project_links.at AS added_project_at,
         milestones.first_active_on,
         milestones.past_1h_on,
         milestones.past_5h_on,
         milestones.past_10h_on,
         ship_firsts.shipped_at,
         ship_firsts.approved_at,
         purchases.bought_at
  FROM insights_private.people
  JOIN public.users ON users.id = people.user_id
  LEFT JOIN public.hackatime_connections connections ON connections.user_id = people.user_id
  -- Everything below is looked up per person (LATERAL, an index probe or a short index range each) instead of aggregated over a whole table and
  -- joined: the planner then reads only the people a date window or referral filter leaves, however big the ledger and the event table grow.
  -- OFFSET 0 keeps the planner from copying the subqueries into every place the column is used.
  CROSS JOIN LATERAL (
    SELECT COALESCE((SELECT MIN(analytics_events.occurred_at) FROM public.analytics_events WHERE analytics_events.user_id = people.user_id AND analytics_events.name = 'hackatime_linked'),
                    connections.connected_at,
                    (SELECT MIN(hour_entries.recorded_at) FROM public.hour_entries WHERE hour_entries.user_id = people.user_id AND hour_entries.source = 'hackatime')) AS at
    OFFSET 0
  ) hackatime
  CROSS JOIN LATERAL (SELECT MIN(hackatime_links.created_at) AS at FROM public.hackatime_links WHERE hackatime_links.user_id = people.user_id) project_links
  CROSS JOIN LATERAL (
    -- The local dates a person first did each hours milestone, counting only counted dates and flooring a day at zero (Hours::Totals): the first
    -- active day (at least the game's quick threshold), and the day the running total first reached 1, 5 and 10 hours.
    SELECT MIN(running.local_date) FILTER (WHERE running.seconds >= settings.quick_seconds) AS first_active_on,
           MIN(running.local_date) FILTER (WHERE running.total >= 3600) AS past_1h_on,
           MIN(running.local_date) FILTER (WHERE running.total >= 18000) AS past_5h_on,
           MIN(running.local_date) FILTER (WHERE running.total >= 36000) AS past_10h_on
    FROM (
      SELECT days.local_date, days.seconds, SUM(days.seconds) OVER (ORDER BY days.local_date) AS total
      FROM (
        SELECT hour_entries.local_date, GREATEST(SUM(hour_entries.seconds), 0) AS seconds
        FROM public.hour_entries
        WHERE hour_entries.user_id = people.user_id
          AND hour_entries.local_date >= people.signed_up_on - (SELECT days_before_signup_counted FROM insights.settings)
        GROUP BY hour_entries.local_date
      ) days
    ) running
    CROSS JOIN insights.settings
  ) milestones
  CROSS JOIN LATERAL (
    SELECT MIN(ships.submitted_at) AS shipped_at, MIN(ships.reviewed_at) FILTER (WHERE ships.status = 'approved') AS approved_at
    FROM public.ships WHERE ships.user_id = people.user_id
  ) ship_firsts
  CROSS JOIN LATERAL (
    SELECT MIN(orders.created_at) AS bought_at
    FROM public.orders WHERE orders.user_id = people.user_id AND orders.kind = 'purchase' AND orders.status <> 'cancelled'
  ) purchases
) facts;

-- ------------------------------------------------------------------------------------------------------------------------------------------
-- Outside readers (a dashboard, a BI tool, an MCP): the role insights_reader, when it exists (`rake insights:reader_role`), may read the public
-- views and nothing else. Views run with their owner's rights, so the role needs no access to public or insights_private.
-- ------------------------------------------------------------------------------------------------------------------------------------------
DO $grants$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'insights_reader') THEN
    GRANT USAGE ON SCHEMA insights TO insights_reader;
    GRANT SELECT ON ALL TABLES IN SCHEMA insights TO insights_reader;
  END IF;
END
$grants$;
